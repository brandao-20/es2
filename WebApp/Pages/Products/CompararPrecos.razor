@page "/comparar-precos"
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h3>Comparar Preços de Produtos</h3>

<div class="form-group">
    <label for="produtoId">Selecionar Produto:</label>
    <select @onchange="OnProdutoChangedAsync" class="form-control" style="width: 300px;">
        <option value="0">Escolha um produto...</option>
        @foreach (var produto in produtos)
        {
            <option value="@produto.ProdutoId">@produto.Nome (@produto.Marca)</option>
        }
    </select>
</div>

@if (produtoId > 0)
{
    @if (lojasDisponiveis == null || !lojasDisponiveis.Any())
    {
        <p>Sem lojas disponíveis para este produto.</p>
    }
    else
    {
        <div class="form-group mt-3">
            <label for="lojaId1">Selecionar Primeira Loja:</label>
            <select @onchange="OnLoja1ChangedAsync" class="form-control" style="width: 300px;">
                <option value="0">Escolha uma loja...</option>
                @foreach (var loja in lojasDisponiveis)
                {
                    <option value="@loja.LojaId">@loja.Nome</option>
                }
            </select>
        </div>

        <div class="form-group mt-3">
            <label for="lojaId2">Selecionar Segunda Loja:</label>
            <select @onchange="OnLoja2ChangedAsync" class="form-control" style="width: 300px;">
                <option value="0">Escolha uma loja...</option>
                @foreach (var loja in lojasDisponiveis)
                {
                    <option value="@loja.LojaId">@loja.Nome</option>
                }
            </select>
        </div>

        @if (lojaId1 > 0 && lojaId2 > 0 && lojaId1 != lojaId2)
        {
            <h4 class="mt-4">Preços Atuais do Produto: @nomeProduto</h4>
            @if (precosAtuais != null && precosAtuais.Any())
            {
                <table class="table table-striped mt-3">
                    <thead>
                        <tr>
                            <th>Loja</th>
                            <th>Preço (€)</th>
                            <th>Data de Registo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var preco in precosAtuais)
                        {
                            <tr>
                                <td>@preco.NomeLoja</td>
                                <td>@preco.Preco.ToString("F2")</td>
                                <td>@preco.DataRegisto.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>Sem preços registados para este produto nas lojas selecionadas.</p>
            }

            <h4>Histórico de Preços</h4>
            @if (isLoadingChart)
            {
                <p>Carregando gráfico...</p>
            }
            else if (historicoPrecos != null && historicoPrecos.Any(h => h.Prices != null && h.Prices.Any()))
            {
                <div style="max-width: 800px; margin: auto;" id="chartContainer">
                    <canvas id="precoChart" style="max-height: 400px;"></canvas>
                </div>
            }
            else
            {
                <p>Sem histórico de preços para as lojas selecionadas.</p>
            }
        }
        else if (lojaId1 > 0 && lojaId2 > 0 && lojaId1 == lojaId2)
        {
            <p class="mt-3 text-danger">Por favor, selecione lojas diferentes para comparar os preços.</p>
        }
        else
        {
            <p class="mt-3">Por favor, selecione duas lojas para comparar os preços.</p>
        }
    }
}

@code {
    private List<Produto> produtos = new();
    private int produtoId;
    private int lojaId1;
    private int lojaId2;
    private List<LojaDTO> lojasDisponiveis = new();
    private string? nomeProduto;
    private List<PrecoAtualDTO>? precosAtuais;
    private List<PriceHistoryDto>? historicoPrecos;
    private bool isLoadingChart = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("[DEBUG] Carregando lista de produtos...");
            var response = await Http.GetAsync("api/precos/produtos");
            Console.WriteLine($"[DEBUG] Resposta do endpoint /api/precos/produtos: Status {response.StatusCode}");
            if (response.IsSuccessStatusCode)
            {
                produtos = await response.Content.ReadFromJsonAsync<List<Produto>>() ?? new List<Produto>();
                Console.WriteLine($"[DEBUG] Produtos carregados: {produtos.Count}");
            }
            else
            {
                Console.WriteLine($"[DEBUG] Erro ao carregar produtos: Status {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Exceção ao carregar produtos: {ex.Message}\n{ex.StackTrace}");
        }
    }

    private async Task OnProdutoChangedAsync(ChangeEventArgs e)
    {
        produtoId = int.Parse(e.Value?.ToString() ?? "0");
        Console.WriteLine($"[DEBUG] Produto selecionado: ID {produtoId}");

        if (produtoId > 0)
        {
            try
            {
                Console.WriteLine($"[DEBUG] Carregando dados para o produto {produtoId}...");
                var response = await Http.GetAsync($"api/precos/comparar/{produtoId}");
                Console.WriteLine($"[DEBUG] Resposta do endpoint /api/precos/comparar/{produtoId}: Status {response.StatusCode}");
                if (response.IsSuccessStatusCode)
                {
                    var comparacao = await response.Content.ReadFromJsonAsync<PrecoComparacaoDTO>();
                    lojasDisponiveis = comparacao?.LojasDisponiveis ?? new List<LojaDTO>();
                    nomeProduto = comparacao?.NomeProduto;
                    Console.WriteLine($"[DEBUG] Lojas disponíveis: {lojasDisponiveis.Count}, Nome do produto: {nomeProduto}");
                }
                else
                {
                    Console.WriteLine($"[DEBUG] Erro ao carregar dados do produto: Status {response.StatusCode}");
                    lojasDisponiveis = new List<LojaDTO>();
                    nomeProduto = null;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DEBUG] Exceção ao carregar dados do produto {produtoId}: {ex.Message}\n{ex.StackTrace}");
                lojasDisponiveis = new List<LojaDTO>();
                nomeProduto = null;
            }
        }
        else
        {
            lojasDisponiveis = new List<LojaDTO>();
            nomeProduto = null;
            precosAtuais = null;
            historicoPrecos = null;
        }

        lojaId1 = 0;
        lojaId2 = 0;
        precosAtuais = null;
        historicoPrecos = null;
        isLoadingChart = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnLoja1ChangedAsync(ChangeEventArgs e)
    {
        lojaId1 = int.Parse(e.Value?.ToString() ?? "0");
        await AtualizarComparacao();
    }

    private async Task OnLoja2ChangedAsync(ChangeEventArgs e)
    {
        lojaId2 = int.Parse(e.Value?.ToString() ?? "0");
        await AtualizarComparacao();
    }

    private async Task AtualizarComparacao()
    {
        Console.WriteLine($"[DEBUG] Lojas selecionadas: LojaId1={lojaId1}, LojaId2={lojaId2}");

        if (produtoId <= 0 || lojaId1 <= 0 || lojaId2 <= 0 || lojaId1 == lojaId2)
        {
            precosAtuais = null;
            historicoPrecos = null;
            isLoadingChart = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Carregar preços atuais
        try
        {
            Console.WriteLine($"[DEBUG] Carregando preços atuais para o produto {produtoId} com lojas {lojaId1} e {lojaId2}...");
            var comparacaoResponse = await Http.GetAsync($"api/precos/comparar/{produtoId}?lojaId1={lojaId1}&lojaId2={lojaId2}");
            Console.WriteLine($"[DEBUG] Resposta do endpoint /api/precos/comparar/{produtoId}: Status {comparacaoResponse.StatusCode}");
            if (comparacaoResponse.IsSuccessStatusCode)
            {
                var comparacao = await comparacaoResponse.Content.ReadFromJsonAsync<PrecoComparacaoDTO>();
                precosAtuais = comparacao?.PrecosAtuais;
                Console.WriteLine($"[DEBUG] Preços atuais carregados: {precosAtuais?.Count ?? 0}");
                if (precosAtuais != null)
                {
                    foreach (var preco in precosAtuais)
                    {
                        Console.WriteLine($"[DEBUG] Preço atual - Loja: {preco.NomeLoja}, Preço: {preco.Preco}, Data: {preco.DataRegisto}");
                    }
                }
            }
            else
            {
                Console.WriteLine($"[DEBUG] Erro ao carregar preços atuais: Status {comparacaoResponse.StatusCode}");
                precosAtuais = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Exceção ao carregar preços atuais: {ex.Message}\n{ex.StackTrace}");
            precosAtuais = null;
        }

        // Carregar histórico de preços
        isLoadingChart = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            Console.WriteLine($"[DEBUG] Carregando histórico de preços para o produto {produtoId} com lojas {lojaId1} e {lojaId2}...");
            var response = await Http.GetAsync($"api/Relatorios/produtos/{produtoId}/pricehistory?groupByStore=true");
            Console.WriteLine($"[DEBUG] Resposta do endpoint /api/Relatorios/produtos/{produtoId}/pricehistory: Status {response.StatusCode}");
            if (response.IsSuccessStatusCode)
            {
                var historyApiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<PriceHistoryDto>>>();
                if (historyApiResponse?.Success == true)
                {
                    historicoPrecos = historyApiResponse.Data
                        ?.Where(h => h.LojaNome == lojasDisponiveis.FirstOrDefault(l => l.LojaId == lojaId1)?.Nome ||
                                     h.LojaNome == lojasDisponiveis.FirstOrDefault(l => l.LojaId == lojaId2)?.Nome)
                        .ToList();
                    Console.WriteLine($"[DEBUG] Histórico de preços carregado: {historicoPrecos?.Count ?? 0} entradas");
                    if (historicoPrecos != null)
                    {
                        foreach (var history in historicoPrecos)
                        {
                            Console.WriteLine($"[DEBUG] Histórico - Loja: {history.LojaNome}, Preços: {history.Prices?.Count ?? 0}");
                            if (history.Prices != null)
                            {
                                foreach (var price in history.Prices)
                                {
                                    Console.WriteLine($"[DEBUG] Data: {price.Date}, Preço: {price.Price}");
                                }
                            }
                        }
                    }
                }
                else
                {
                    Console.WriteLine($"[DEBUG] Falha ao carregar histórico: {historyApiResponse?.Message}");
                    historicoPrecos = null;
                }
            }
            else
            {
                Console.WriteLine($"[DEBUG] Erro ao carregar histórico: Status {response.StatusCode}");
                historicoPrecos = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Exceção ao carregar histórico de preços: {ex.Message}\n{ex.StackTrace}");
            historicoPrecos = null;
        }
        finally
        {
            isLoadingChart = false;
            await InvokeAsync(StateHasChanged);
            if (historicoPrecos != null && historicoPrecos.Any(h => h.Prices != null && h.Prices.Any()))
            {
                await RenderizarGrafico();
            }
        }
    }

    private async Task RenderizarGrafico()
    {
        try
        {
            var canvasExists = await JSRuntime.InvokeAsync<bool>("eval", "!!document.getElementById('precoChart')");
            Console.WriteLine($"[DEBUG] Canvas 'precoChart' existe: {canvasExists}");

            if (canvasExists)
            {
                await JSRuntime.InvokeVoidAsync("renderPriceChart", historicoPrecos);
                Console.WriteLine("[DEBUG] Gráfico de comparação renderizado com sucesso.");
            }
            else
            {
                Console.WriteLine("[DEBUG] Canvas 'precoChart' não encontrado no DOM.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Erro ao renderizar o gráfico: {ex.Message}\n{ex.StackTrace}");
        }
    }

    public class Produto
    {
        public int ProdutoId { get; set; }
        public string? Nome { get; set; }
        public string? Marca { get; set; }
    }

    public class PrecoComparacaoDTO
    {
        public string? NomeProduto { get; set; }
        public List<LojaDTO>? LojasDisponiveis { get; set; }
        public List<PrecoAtualDTO>? PrecosAtuais { get; set; }
        public List<HistoricoPrecoDTO>? HistoricoPrecos { get; set; }
    }

    public class LojaDTO
    {
        public int LojaId { get; set; }
        public string? Nome { get; set; }
    }

    public class PrecoAtualDTO
    {
        public string? NomeLoja { get; set; }
        public decimal Preco { get; set; }
        public DateTime DataRegisto { get; set; }
    }

    public class HistoricoPrecoDTO
    {
        public string? NomeLoja { get; set; }
        public decimal Preco { get; set; }
        public DateTime DataRegisto { get; set; }
    }

    private class PriceHistoryDto
    {
        public string? LojaNome { get; set; }
        public List<PricePoint>? Prices { get; set; }
    }

    private class PricePoint
    {
        public DateTime Date { get; set; }
        public decimal Price { get; set; }
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
