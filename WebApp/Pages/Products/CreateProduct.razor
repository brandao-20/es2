@page "/produtos/novo"
@using WebApp.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Criar Produto</PageTitle>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para criar produtos.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <h3>Criar Produto</h3>
    <EditForm Model="novoProduto" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nome:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Nome" />
        </div>
        <div class="mb-3">
            <label>Marca:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Marca" />
        </div>
        <div class="mb-3">
            <label>Descrição:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Descricao" />
        </div>
        <div class="mb-3">
            <label>Categoria:</label>
            <!-- Aqui você pode optar por um dropdown se tiver uma lista de categorias -->
            <select class="form-select" @bind="novoProduto.CategoriaId">
                @if (categorias != null)
                {
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.CategoriaId">@cat.Nome</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Criar Produto</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">Voltar</button>
    </EditForm>
}

@if (!string.IsNullOrEmpty(mensagem))
{
    <p>@mensagem</p>
}

@code {
    private Produto novoProduto = new();
    private List<Categoria>? categorias;
    private string? mensagem;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            categorias = await Http.GetFromJsonAsync<List<Categoria>>("api/Categorias");
            if (categorias?.Count > 0)
            {
                novoProduto.CategoriaId = categorias[0].CategoriaId;
            }
        }
    }

    private async Task HandleSubmit()
    {
        // Garanta que o objeto de navegação não seja enviado
        novoProduto.Categoria = null;

        var response = await Http.PostAsJsonAsync("api/Produtos", novoProduto);
        if (response.IsSuccessStatusCode)
        {
            mensagem = "Produto criado com sucesso!";
            Navigation.NavigateTo("/produtos");
        }
        else
        {
            var debugText = await response.Content.ReadAsStringAsync();
            mensagem = $"Erro ao criar produto: {debugText}";
        }
    }

    private void Voltar() => Navigation.NavigateTo("/produtos");
}
