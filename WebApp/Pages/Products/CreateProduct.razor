@page "/produtos/novo"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Criar Produto</PageTitle>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para criar produtos.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <h3>Criar Produto</h3>
    <EditForm Model="novoProduto" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nome:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Nome" />
        </div>
        <div class="mb-3">
            <label>Marca:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Marca" />
        </div>
        <div class="mb-3">
            <label>Descrição:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Descricao" />
        </div>
        <div class="mb-3">
            <label>Categoria:</label>
            <select class="form-select" @bind="novoProduto.CategoriaId">
                @if (categorias != null)
                {
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.CategoriaId">@cat.Nome</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Criar Produto</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">Voltar</button>
    </EditForm>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private Produto novoProduto = new();
    private List<Categoria>? categorias;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            try
            {
                var response = await Http.GetAsync("api/Categorias");
                if (response.IsSuccessStatusCode)
                {
                    categorias = await response.Content.ReadFromJsonAsync<List<Categoria>>();
                    if (categorias?.Count > 0)
                    {
                        novoProduto.CategoriaId = categorias[0].CategoriaId;
                    }
                }
                else
                {
                    categorias = new List<Categoria>();
                    var errorContent = await response.Content.ReadAsStringAsync();
                    try
                    {
                        var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                        if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                        {
                            ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                        }
                        else
                        {
                            ShowPopup("Erro ao carregar as categorias. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                        }
                    }
                    catch
                    {
                        ShowPopup($"Erro ao carregar as categorias: {errorContent}", MessagePopup.MessageType.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                categorias = new List<Categoria>();
                ShowPopup($"Erro inesperado ao carregar as categorias: {ex.Message}", MessagePopup.MessageType.Error);
            }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            // Garanta que o objeto de navegação não seja enviado
            novoProduto.Categoria = null;

            var response = await Http.PostAsJsonAsync("api/Produtos", novoProduto);
            if (response.IsSuccessStatusCode)
            {
                // Redireciona com a mensagem de sucesso como parâmetro de consulta
                Navigation.NavigateTo($"/produtos?successMessage={Uri.EscapeDataString("Produto criado com sucesso!")}");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao criar o produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao criar o produto: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao criar o produto: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Voltar() => Navigation.NavigateTo("/produtos");

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
