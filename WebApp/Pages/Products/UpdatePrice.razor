@page "/updateprice/{RegistoPrecoId:int}"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Atualizar Preço</PageTitle>
<h3>Atualizar Preço do Produto</h3>

@if (!AuthService.IsLoggedIn)
{
    <p>Você precisa estar logado para atualizar preços.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    @if (priceUpdate == null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <EditForm Model="@priceUpdate" OnValidSubmit="HandleUpdate">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label>Produto:</label>
                <InputSelect class="form-control" @bind-Value="priceUpdate.ProdutoId" disabled>
                    @if (produtos != null)
                    {
                        @foreach (var p in produtos)
                        {
                            <option value="@p.ProdutoId">@p.Nome</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label>Loja:</label>
                <InputSelect class="form-control" @bind-Value="priceUpdate.LojaId" disabled>
                    @if (lojas != null)
                    {
                        @foreach (var l in lojas)
                        {
                            <option value="@l.LojaId">@l.Nome</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label>Novo Preço:</label>
                <InputNumber class="form-control" @bind-Value="priceUpdate.Preco" />
            </div>
            <div class="mb-3">
                <label>Data:</label>
                <InputDate class="form-control" @bind-Value="priceUpdate.DataRegisto" />
            </div>
            <button type="submit" class="btn btn-primary">Atualizar Preço</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">Voltar</button>
        </EditForm>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter]
    public int RegistoPrecoId { get; set; }

    private RegistosPreco? priceUpdate;
    private List<Produto>? produtos;
    private List<Loja>? lojas;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            // Carregar o registo de preço existente
            var priceResponse = await Http.GetAsync($"api/RegistosPrecos/{RegistoPrecoId}");
            if (priceResponse.IsSuccessStatusCode)
            {
                priceUpdate = await priceResponse.Content.ReadFromJsonAsync<RegistosPreco>();
                if (priceUpdate == null)
                {
                    ShowPopup("Registo de preço não encontrado.", MessagePopup.MessageType.Error);
                    return;
                }
            }
            else
            {
                priceUpdate = null;
                var errorContent = await priceResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar o registo de preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar o registo de preço: {errorContent}", MessagePopup.MessageType.Error);
                }
                return;
            }

            // Carregar produtos
            var prodResponse = await Http.GetAsync("api/Produtos");
            if (prodResponse.IsSuccessStatusCode)
            {
                produtos = await prodResponse.Content.ReadFromJsonAsync<List<Produto>>();
            }
            else
            {
                produtos = new List<Produto>();
                var errorContent = await prodResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar os produtos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar os produtos: {errorContent}", MessagePopup.MessageType.Error);
                }
            }

            // Carregar lojas
            var lojaResponse = await Http.GetAsync("api/Lojas");
            if (lojaResponse.IsSuccessStatusCode)
            {
                lojas = await lojaResponse.Content.ReadFromJsonAsync<List<Loja>>();
            }
            else
            {
                lojas = new List<Loja>();
                var errorContent = await lojaResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar as lojas. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar as lojas: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            priceUpdate = null;
            produtos = new List<Produto>();
            lojas = new List<Loja>();
            ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task HandleUpdate()
    {
        if (priceUpdate == null) return;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/RegistosPrecos/{priceUpdate.RegistoPrecoId}", priceUpdate);
            if (response.IsSuccessStatusCode)
            {
                ShowPopup("Preço atualizado com sucesso!", MessagePopup.MessageType.Success);
                Navigation.NavigateTo($"/productdetails/{priceUpdate.ProdutoId}");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao atualizar o preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao atualizar o preço: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao atualizar o preço: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Voltar()
    {
        Navigation.NavigateTo($"/productdetails/{priceUpdate?.ProdutoId ?? 0}");
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
