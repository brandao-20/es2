@page "/productdetails/{Id:int}"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Detalhes do Produto</PageTitle>

<h3>Detalhes do Produto</h3>

@if (produto == null)
{
    <p>Carregando...</p>
}
else
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@produto.Nome</h4>
            <p class="card-text"><strong>Marca:</strong> @produto.Marca</p>
            <p class="card-text"><strong>Descrição:</strong> @produto.Descricao</p>
            <p class="card-text"><strong>Categoria:</strong> @produto.Categoria?.Nome</p>
            <!-- Exibição da Credibilidade Ajustada -->
            @if (credibilidade.HasValue)
            {
                <p class="card-text">
                    <strong>Credibilidade:</strong>
                    <span class="badge @GetAdjustedCredibilityClass(credibilidade.Value)" 
                          title="A credibilidade é ajustada com base na antiguidade dos preços registrados. Valores mais recentes aumentam a credibilidade.">
                        @credibilidade.Value.ToString("F2") (ajustada por antiguidade)
                    </span>
                </p>
            }
            else
            {
                <p class="card-text"><strong>Credibilidade:</strong> Não disponível</p>
            }
        </div>
    </div>

    <h4 class="mt-4">Registos de Preços</h4>

    @if (registosPrecos == null || registosPrecos.Count == 0)
    {
        <p>Nenhum registo de preço encontrado para este produto.</p>
    }
    else
    {
        <div class="mb-3">
            <!-- Botão para alternar entre 'Mais Recentes' e 'Histórico Completo' -->
            <button class="btn btn-secondary" @onclick="ToggleHistory">
                @(showHistory ? "Exibir apenas preços mais recentes" : "Ver Histórico Completo")
            </button>
        </div>

        <!-- Lógica: se showHistory == true, exibe todos; senão, exibe só o mais recente por loja -->
        @if (showHistory)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Loja</th>
                        <th>Preço</th>
                        <th>Data</th>
                        <th>Credibilidade</th>
                        @if (AuthService.IsLoggedIn)
                        {
                            <th>Ações</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registo in registosPrecos.OrderByDescending(r => r.DataRegisto))
                    {
                        <tr>
                            <td>@registo.LojaNome</td>
                            <td>@registo.Preco.ToString("C")</td>
                            <td>@registo.DataRegisto.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="@GetCredibilidadeClass(registo.Credibilidade)">
                                    @(registo.Credibilidade >= 0.8m ? "Alta" 
                                      : registo.Credibilidade >= 0.5m ? "Média" 
                                      : "Baixa")
                                </span>
                            </td>
                            @if (AuthService.IsLoggedIn)
                            {
                                <td>
                                    <a href="/updateprice/@registo.RegistoPrecoId" class="btn btn-sm btn-warning">
                                        Atualizar Preço
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <!-- Exibe apenas o mais recente de cada loja -->
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Loja</th>
                        <th>Preço</th>
                        <th>Data</th>
                        <th>Credibilidade</th>
                        @if (AuthService.IsLoggedIn)
                        {
                            <th>Ações</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registo in DistinctByLojaRegistos)
                    {
                        <tr>
                            <td>@registo.LojaNome</td>
                            <td>@registo.Preco.ToString("C")</td>
                            <td>@registo.DataRegisto.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="@GetCredibilidadeClass(registo.Credibilidade)">
                                    @(registo.Credibilidade >= 0.8m ? "Alta" 
                                      : registo.Credibilidade >= 0.5m ? "Média" 
                                      : "Baixa")
                                </span>
                            </td>
                            @if (AuthService.IsLoggedIn)
                            {
                                <td>
                                    <a href="/updateprice/@registo.RegistoPrecoId" class="btn btn-sm btn-warning">
                                        Atualizar Preço
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <button class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter]
    public int Id { get; set; }

    private Produto? produto;
    private List<RegistosPreco>? registosPrecos;
    private double? credibilidade; // Armazena a credibilidade ajustada por antiguidade

    // Propriedade para agrupar e exibir só o mais recente por loja
    private List<RegistosPreco> DistinctByLojaRegistos = new();
    private bool showHistory = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            // Carregar os detalhes do produto
            var prodResponse = await Http.GetAsync($"api/Produtos/{Id}");
            if (prodResponse.IsSuccessStatusCode)
            {
                produto = await prodResponse.Content.ReadFromJsonAsync<Produto>();
            }
            else
            {
                produto = null;
                var errorContent = await prodResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar os detalhes do produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar os detalhes do produto: {errorContent}", MessagePopup.MessageType.Error);
                }
            }

            // Carregar a credibilidade ajustada por antiguidade
            var credibilidadeResponse = await Http.GetAsync($"api/Produtos/{Id}/credibilidade");
            if (credibilidadeResponse.IsSuccessStatusCode)
            {
                var credibilidadeData = await credibilidadeResponse.Content.ReadFromJsonAsync<CredibilidadeResponse>();
                credibilidade = credibilidadeData?.Credibilidade;
            }
            else
            {
                credibilidade = null;
                var errorContent = await credibilidadeResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar a credibilidade. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar a credibilidade: {errorContent}", MessagePopup.MessageType.Error);
                }
            }

            // Carregar os registos de preço deste produto
            var regResponse = await Http.GetAsync($"api/RegistosPrecos/produto/{Id}");
            if (regResponse.IsSuccessStatusCode)
            {
                registosPrecos = await regResponse.Content.ReadFromJsonAsync<List<RegistosPreco>>() ?? new List<RegistosPreco>();
                // Monta a lista "DistinctByLojaRegistos" com o mais recente por loja
                DistinctByLojaRegistos = registosPrecos
                    .GroupBy(r => r.LojaId)
                    .Select(g => g.OrderByDescending(x => x.DataRegisto).First())
                    .OrderByDescending(r => r.DataRegisto)
                    .ToList();
            }
            else
            {
                registosPrecos = new List<RegistosPreco>();
                DistinctByLojaRegistos = new List<RegistosPreco>();
                var errorContent = await regResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar os registos de preços. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar os registos de preços: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            produto = null;
            registosPrecos = new List<RegistosPreco>();
            DistinctByLojaRegistos = new List<RegistosPreco>();
            credibilidade = null;
            ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ToggleHistory()
    {
        showHistory = !showHistory;
    }

    private string GetCredibilidadeClass(decimal credibilidade)
    {
        if (credibilidade >= 0.8m) return "badge bg-success"; // Alta
        if (credibilidade >= 0.5m) return "badge bg-warning"; // Média
        return "badge bg-danger"; // Baixa
    }

    private string GetAdjustedCredibilityClass(double cred)
    {
        if (cred >= 0.75) return "bg-success";
        if (cred >= 0.5) return "bg-warning";
        return "bg-danger";
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Voltar()
    {
        Navigation.NavigateTo("/produtos");
    }

    private class CredibilidadeResponse
    {
        public double Credibilidade { get; set; }
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
