@page "/prices/new"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Registar Preço</PageTitle>
<h3>Registar Preço</h3>

@if (!AuthService.IsLoggedIn)
{
    <p>Você precisa estar logado para registar um preço.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else if (!isInitialized)
{
    <p>Carregando dados...</p>
}
else
{
    <EditForm Model="newRecord" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Seleção de Produto -->
        <div class="mb-3">
            <label>Produto:</label>
            @if (produtos == null || produtos.Count == 0)
            {
                <p class="text-danger">Nenhum produto disponível.</p>
            }
            else
            {
                <select class="form-select" @bind="newRecord.ProdutoId" @bind:event="onchange">
                    <option value="0">Selecione um produto</option>
                    @foreach (var p in produtos)
                    {
                        <option value="@p.ProdutoId">@p.Nome</option>
                    }
                </select>
            }
        </div>

        <!-- Seleção de Loja -->
        <div class="mb-3">
            <label>Loja:</label>
            @if (lojas == null || lojas.Count == 0)
            {
                <p class="text-danger">Nenhuma loja disponível.</p>
            }
            else
            {
                <select class="form-select" @bind="newRecord.LojaId" @bind:event="onchange">
                    <option value="0">Selecione uma loja</option>
                    @foreach (var l in lojas)
                    {
                        <option value="@l.LojaId">@l.Nome</option>
                    }
                </select>
            }
        </div>

        <!-- Seleção do Tipo de Ação -->
        <div class="mb-3">
            <label>Tipo de Ação:</label>
            @if (tipoAcoes == null || tipoAcoes.Count == 0)
            {
                <p class="text-danger">Nenhum tipo de ação disponível.</p>
            }
            else
            {
                <select class="form-select" @bind="newRecord.TipoAcaoId">
                    <option value="0">Selecione um tipo de ação</option>
                    @foreach (var acao in tipoAcoes)
                    {
                        <option value="@acao.TipoAcaoId">@acao.Tipo</option>
                    }
                </select>
            }
        </div>

        <!-- Campo de Preço -->
        <div class="mb-3">
            <label>Preço:</label>
            <InputNumber class="form-control" @bind-Value="newRecord.Preco" />
            <ValidationMessage For="@(() => newRecord.Preco)" />
        </div>

        <!-- Campo de Data com validação (não permite data futura) -->
        <div class="mb-3">
            <label>Data:</label>
            <InputDate class="form-control" @bind-Value="newRecord.DataRegisto" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
            <ValidationMessage For="@(() => newRecord.DataRegisto)" />
        </div>

        <!-- Se houver um último preço registado, exibe a informação e botão de confirmação -->
        @if (latestRecord != null)
        {
            <div class="alert alert-info">
                Último preço registado: <strong>@latestRecord.Preco.ToString("C")</strong> em <strong>@latestRecord.DataRegisto.ToString("dd/MM/yyyy HH:mm")</strong>.
                <br />
                Deseja confirmar este preço?
                <button type="button" class="btn btn-success btn-sm mt-2" @onclick="ConfirmExistingPrice">Confirmar Preço Existente</button>
            </div>
        }

        <button type="submit" class="btn btn-primary" disabled="@(!CanSubmit)">Registar Novo Preço</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Voltar</button>
    </EditForm>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private RegistosPreco newRecord = new();
    private List<Produto>? produtos;
    private List<Loja>? lojas;
    private List<TipoAcao>? tipoAcoes;
    private RegistosPreco? latestRecord;
    private bool isInitialized = false;
    private bool shouldRedirect = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken() || !AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            // Carrega a lista de produtos
            Console.WriteLine("[DEBUG] Carregando produtos...");
            var prodResponse = await Http.GetAsync("api/Produtos");
            if (prodResponse.IsSuccessStatusCode)
            {
                var json = await prodResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[DEBUG] JSON retornado de api/Produtos: {json}");
                var apiResponse = await prodResponse.Content.ReadFromJsonAsync<ApiResponse<List<Produto>>>();
                if (apiResponse?.Success == true)
                {
                    produtos = apiResponse.Data ?? new List<Produto>();
                    Console.WriteLine($"[DEBUG] Produtos carregados: {produtos.Count}");
                }
                else
                {
                    produtos = new List<Produto>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar os produtos.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                produtos = new List<Produto>();
                ShowPopup("Erro ao carregar os produtos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            // Carrega a lista de lojas
            Console.WriteLine("[DEBUG] Carregando lojas...");
            var lojaResponse = await Http.GetAsync("api/Lojas");
            if (lojaResponse.IsSuccessStatusCode)
            {
                var json = await lojaResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[DEBUG] JSON retornado de api/Lojas: {json}");
                lojas = await lojaResponse.Content.ReadFromJsonAsync<List<Loja>>();
                lojas = lojas ?? new List<Loja>();
                Console.WriteLine($"[DEBUG] Lojas carregadas: {lojas.Count}");
            }
            else
            {
                lojas = new List<Loja>();
                ShowPopup("Erro ao carregar as lojas. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            // Carrega a lista de tipos de ação
            Console.WriteLine("[DEBUG] Carregando tipos de ação...");
            var acaoResponse = await Http.GetAsync("api/TipoAcaos");
            if (acaoResponse.IsSuccessStatusCode)
            {
                var json = await acaoResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[DEBUG] JSON retornado de api/TipoAcaos: {json}");
                var apiResponse = await acaoResponse.Content.ReadFromJsonAsync<ApiResponse<List<TipoAcao>>>();
                if (apiResponse?.Success == true)
                {
                    tipoAcoes = apiResponse.Data ?? new List<TipoAcao>();
                    Console.WriteLine($"[DEBUG] Tipos de ação carregados: {tipoAcoes.Count}");
                }
                else
                {
                    tipoAcoes = new List<TipoAcao>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar os tipos de ação.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                tipoAcoes = new List<TipoAcao>();
                ShowPopup("Erro ao carregar os tipos de ação. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            // Define a data padrão como hoje
            newRecord.DataRegisto = DateTime.Now;
        }
        catch (Exception ex)
        {
            produtos = new List<Produto>();
            lojas = new List<Loja>();
            tipoAcoes = new List<TipoAcao>();
            ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
        }
        finally
        {
            isInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnProdutoOrLojaChanged(ChangeEventArgs e)
    {
        if (newRecord.ProdutoId <= 0 || newRecord.LojaId <= 0)
        {
            latestRecord = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            Console.WriteLine($"[DEBUG] Verificando último preço para ProdutoId: {newRecord.ProdutoId}, LojaId: {newRecord.LojaId}");
            var response = await Http.GetAsync($"api/RegistosPrecos/latest/{newRecord.ProdutoId}/{newRecord.LojaId}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<RegistosPreco>>();
                if (apiResponse?.Success == true)
                {
                    latestRecord = apiResponse.Data;
                    Console.WriteLine($"[DEBUG] Último preço encontrado: {latestRecord?.Preco}");
                }
                else
                {
                    latestRecord = null;
                    ShowPopup(apiResponse?.Message ?? "Erro ao verificar o último preço.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                latestRecord = null;
                ShowPopup("Erro ao verificar o último preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            latestRecord = null;
            ShowPopup($"Erro inesperado ao verificar o último preço: {ex.Message}", MessagePopup.MessageType.Error);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmExistingPrice()
    {
        if (latestRecord == null) return;

        try
        {
            Console.WriteLine($"[DEBUG] Confirmando preço existente para RegistoPrecoId: {latestRecord.RegistoPrecoId}");
            var response = await Http.PostAsJsonAsync($"api/RegistosPrecos/confirm/{latestRecord.RegistoPrecoId}", new { });
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<ConfirmationResponse>>();
                if (apiResponse?.Success == true)
                {
                    shouldRedirect = true;
                    ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao confirmar o preço.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                ShowPopup("Erro ao confirmar o preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao confirmar o preço: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task HandleSubmit()
    {
        if (newRecord.ProdutoId == 0)
        {
            ShowPopup("Selecione um produto.", MessagePopup.MessageType.Error);
            return;
        }

        if (newRecord.LojaId == 0)
        {
            ShowPopup("Selecione uma loja.", MessagePopup.MessageType.Error);
            return;
        }

        if (newRecord.TipoAcaoId == 0)
        {
            ShowPopup("Selecione um tipo de ação.", MessagePopup.MessageType.Error);
            return;
        }

        if (newRecord.Preco <= 0)
        {
            ShowPopup("O preço deve ser maior que zero.", MessagePopup.MessageType.Error);
            return;
        }

        newRecord.Produto = null;
        newRecord.Loja = null;
        newRecord.TipoAcao = null;

        try
        {
            Console.WriteLine($"[DEBUG] Registrando novo preço: ProdutoId={newRecord.ProdutoId}, LojaId={newRecord.LojaId}, Preço={newRecord.Preco}");
            var response = await Http.PostAsJsonAsync("api/RegistosPrecos", newRecord);
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<RegistosPreco>>();
                if (apiResponse?.Success == true)
                {
                    shouldRedirect = true;
                    ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao registar o preço.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                ShowPopup("Erro ao registar o preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao registar o preço: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private bool CanSubmit =>
        produtos != null && produtos.Count > 0 &&
        lojas != null && lojas.Count > 0 &&
        tipoAcoes != null && tipoAcoes.Count > 0 &&
        newRecord.ProdutoId != 0 &&
        newRecord.LojaId != 0 &&
        newRecord.TipoAcaoId != 0 &&
        newRecord.Preco > 0;

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);

        if (shouldRedirect)
        {
            Navigation.NavigateTo($"/produtos?successMessage={Uri.EscapeDataString("Preço registrado com sucesso!")}");
            shouldRedirect = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/produtos");

    private class ConfirmationResponse
    {
        public string Message { get; set; } = "";
        public decimal Credibilidade { get; set; }
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
