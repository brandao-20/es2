@page "/prices/new"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Registar Preço</PageTitle>
<h3>Registar Preço</h3>

@if (!AuthService.IsLoggedIn)
{
    <p>Você precisa estar logado para registar um preço.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else
{
    <EditForm Model="newRecord" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Seleção de Produto -->
        <div class="mb-3">
            <label>Produto:</label>
            <select class="form-select" @bind="newRecord.ProdutoId" @bind:event="onchange">
                <option value="0">Selecione um produto</option>
                @if (produtos != null)
                {
                    @foreach (var p in produtos)
                    {
                        <option value="@p.ProdutoId">@p.Nome</option>
                    }
                }
            </select>
        </div>

        <!-- Seleção de Loja -->
        <div class="mb-3">
            <label>Loja:</label>
            <select class="form-select" @bind="newRecord.LojaId" @bind:event="onchange">
                <option value="0">Selecione uma loja</option>
                @if (lojas != null)
                {
                    @foreach (var l in lojas)
                    {
                        <option value="@l.LojaId">@l.Nome</option>
                    }
                }
            </select>
        </div>

        <!-- Novo campo: Seleção do Tipo de Ação -->
        <div class="mb-3">
            <label>Tipo de Ação:</label>
            <select class="form-select" @bind="newRecord.TipoAcaoId">
                <option value="0">Selecione um tipo de ação</option>
                @if (tipoAcoes != null)
                {
                    @foreach (var acao in tipoAcoes)
                    {
                        <option value="@acao.TipoAcaoId">@acao.Tipo</option>
                    }
                }
            </select>
        </div>

        <!-- Campo de Preço -->
        <div class="mb-3">
            <label>Preço:</label>
            <InputNumber class="form-control" @bind-Value="newRecord.Preco" />
            <ValidationMessage For="@(() => newRecord.Preco)" />
        </div>

        <!-- Campo de Data com validação (não permite data futura) -->
        <div class="mb-3">
            <label>Data:</label>
            <InputDate class="form-control" @bind-Value="newRecord.DataRegisto" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
            <ValidationMessage For="@(() => newRecord.DataRegisto)" />
        </div>

        <!-- Se houver um último preço registado, exibe a informação e botão de confirmação -->
        @if (latestRecord != null)
        {
            <div class="alert alert-info">
                Último preço registado: <strong>@latestRecord.Preco.ToString("C")</strong> em <strong>@latestRecord.DataRegisto.ToString("dd/MM/yyyy HH:mm")</strong>.
                <br />
                Deseja confirmar este preço?
                <button type="button" class="btn btn-success btn-sm mt-2" @onclick="ConfirmExistingPrice">Confirmar Preço Existente</button>
            </div>
        }

        <button type="submit" class="btn btn-primary">Registar Novo Preço</button>
    </EditForm>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    // Modelo para o novo registo de preço
    private RegistosPreco newRecord = new();

    // Listas de produtos, lojas e tipos de ação
    private List<Produto>? produtos;
    private List<Loja>? lojas;
    private List<TipoAcao>? tipoAcoes;

    // Último registo de preço para o produto/loja selecionados
    private RegistosPreco? latestRecord;

    // Propriedades do popup
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            // Carrega a lista de produtos
            var prodResponse = await Http.GetAsync("api/Produtos");
            if (prodResponse.IsSuccessStatusCode)
            {
                produtos = await prodResponse.Content.ReadFromJsonAsync<List<Produto>>();
            }
            else
            {
                produtos = new List<Produto>();
                var errorContent = await prodResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar os produtos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar os produtos: {errorContent}", MessagePopup.MessageType.Error);
                }
            }

            // Carrega a lista de lojas
            var lojaResponse = await Http.GetAsync("api/Lojas");
            if (lojaResponse.IsSuccessStatusCode)
            {
                lojas = await lojaResponse.Content.ReadFromJsonAsync<List<Loja>>();
            }
            else
            {
                lojas = new List<Loja>();
                var errorContent = await lojaResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar as lojas. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar as lojas: {errorContent}", MessagePopup.MessageType.Error);
                }
            }

            // Carrega a lista de tipos de ação
            var acaoResponse = await Http.GetAsync("api/TipoAcaos");
            if (acaoResponse.IsSuccessStatusCode)
            {
                tipoAcoes = await acaoResponse.Content.ReadFromJsonAsync<List<TipoAcao>>();
            }
            else
            {
                tipoAcoes = new List<TipoAcao>();
                var errorContent = await acaoResponse.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar os tipos de ação. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar os tipos de ação: {errorContent}", MessagePopup.MessageType.Error);
                }
            }

            // Define a data padrão como hoje
            newRecord.DataRegisto = DateTime.Now;
        }
        catch (Exception ex)
        {
            produtos = new List<Produto>();
            lojas = new List<Loja>();
            tipoAcoes = new List<TipoAcao>();
            ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    // Chamado sempre que Produto ou Loja forem alterados
    private async Task OnProdutoOrLojaChanged(ChangeEventArgs e)
    {
        // Se ambos os campos forem selecionados (valor diferente de zero), verifica o último preço
        if (newRecord.ProdutoId != 0 && newRecord.LojaId != 0)
        {
            try
            {
                var response = await Http.GetAsync($"api/RegistosPrecos/latest/{newRecord.ProdutoId}/{newRecord.LojaId}");
                if (response.IsSuccessStatusCode)
                {
                    latestRecord = await response.Content.ReadFromJsonAsync<RegistosPreco>();
                }
                else
                {
                    latestRecord = null;
                    var errorContent = await response.Content.ReadAsStringAsync();
                    try
                    {
                        var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                        if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                        {
                            ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                        }
                        else
                        {
                            ShowPopup("Erro ao verificar o último preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                        }
                    }
                    catch
                    {
                        ShowPopup($"Erro ao verificar o último preço: {errorContent}", MessagePopup.MessageType.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                latestRecord = null;
                ShowPopup($"Erro inesperado ao verificar o último preço: {ex.Message}", MessagePopup.MessageType.Error);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    // Método para confirmar o preço existente
    private async Task ConfirmExistingPrice()
    {
        if (latestRecord == null)
            return;

        try
        {
            // Chama o endpoint de confirmação passando o ID do último registo
            var response = await Http.PostAsJsonAsync($"api/RegistosPrecos/confirm/{latestRecord.RegistoPrecoId}", new { });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ConfirmationResponse>();
                ShowPopup(result?.message ?? "Preço confirmado com sucesso.", MessagePopup.MessageType.Success);
                Navigation.NavigateTo("/produtos");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao confirmar o preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao confirmar o preço: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao confirmar o preço: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    // Método para registar um novo preço (submit do formulário)
    private async Task HandleSubmit()
    {
        // Definir propriedades de navegação como null para evitar serialização
        newRecord.Produto = null;
        newRecord.Loja = null;
        newRecord.TipoAcao = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/RegistosPrecos", newRecord);
            if (response.IsSuccessStatusCode)
            {
                ShowPopup("Preço registado com sucesso!", MessagePopup.MessageType.Success);
                Navigation.NavigateTo("/produtos");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao registar o preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao registar o preço: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao registar o preço: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private void GoBack() => Navigation.NavigateTo("/produtos");

    public class ConfirmationResponse
    {
        public string message { get; set; } = "";
        public decimal credibilidade { get; set; }
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
