@page "/produtos"
@using WebApp.Models
@inject HttpClient Http
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Lista de Produtos</PageTitle>
<h3>Lista de Produtos</h3>

@if (produtos == null)
{
    <p>Carregando...</p>
}
else if (!produtos.Any())
{
    <p>Nenhum produto encontrado.</p>
}
else
{
    <div class="mb-3">
        @if (AuthService.IsAdmin || AuthService.IsManager)
        {
            <button class="btn btn-primary me-2" @onclick="IrParaCriarProduto">Criar Novo Produto</button>
            <a href="/prices/new" class="btn btn-primary">Registar Preço</a>
        }
    </div>
    
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Marca</th>
                <th>Categoria</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in produtos)
            {
                <tr>
                    <td>@prod.ProdutoId</td>
                    <td>@prod.Nome</td>
                    <td>@prod.Marca</td>
                    <td>@prod.Categoria?.Nome</td>
                    <td>
                        <a href="/productdetails/@prod.ProdutoId" class="btn btn-info btn-sm me-2">Ver Detalhes</a>
                        @if (AuthService.IsAdmin || AuthService.IsManager)
                        {
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(prod.ProdutoId))">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => Excluir(prod.ProdutoId))">Excluir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Anterior</button>
        <span>Página @currentPage de @totalPages</span>
        <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoNext)">Próximo</button>
    </div>
}

@code {
    private List<Produto>? produtos;

    // Controle de paginação
    private int currentPage = 1;
    private int pageSize = 5; 
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        var response = await Http.GetAsync($"api/Produtos?page={currentPage}&pageSize={pageSize}");
        if (response.IsSuccessStatusCode)
        {
            produtos = await response.Content.ReadFromJsonAsync<List<Produto>>();

            if (response.Headers.TryGetValues("X-Total-Count", out var values))
            {
                if (int.TryParse(values.FirstOrDefault(), out int totalItems))
                {
                    totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                }
            }
            else
            {
                totalPages = 1;
            }

            // LÓGICA DE FALLBACK
            // Se a página atual ficar maior que o total de páginas (ex.: deletou um item e a page 2 não existe mais),
            // volte para a última página existente e recarregue.
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
                await CarregarProdutos(); 
                return; 
            }
        }
        else
        {
            produtos = new List<Produto>();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await CarregarProdutos();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await CarregarProdutos();
        }
    }

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    private void IrParaCriarProduto() => Navigation.NavigateTo("/produtos/novo");
    private void Editar(int produtoId) => Navigation.NavigateTo($"/produtos/editar/{produtoId}");

    private async Task Excluir(int produtoId)
    {
        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm", $"Tem certeza que deseja excluir o produto {produtoId}?");
        if (!confirmar) return;

        var response = await Http.DeleteAsync($"api/Produtos/{produtoId}");
        if (response.IsSuccessStatusCode)
        {
            await CarregarProdutos();
        }
    }
}
