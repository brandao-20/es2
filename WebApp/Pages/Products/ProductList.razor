@page "/produtos"
@using WebApp.Models
@inject HttpClient Http
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Lista de Produtos</PageTitle>
<h3>Lista de Produtos</h3>

@if (produtos == null)
{
    <p>Carregando...</p>
}
else if (!produtos.Any())
{
    <p>Nenhum produto encontrado.</p>
}
else
{
    <div class="mb-3">
        @if (AuthService.IsAdmin || AuthService.IsManager)
        {
            <button class="btn btn-primary" @onclick="IrParaCriarProduto">Criar Novo Produto</button>
        }
    </div>
    
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Marca</th>
                <th>Categoria</th>
                @if (AuthService.IsAdmin || AuthService.IsManager)
                {
                    <th>Ações</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in produtos)
            {
                <tr>
                    <td>@prod.ProdutoId</td>
                    <td>@prod.Nome</td>
                    <td>@prod.Marca</td>
                    <td>@prod.Categoria?.Nome</td>
                    @if (AuthService.IsAdmin || AuthService.IsManager)
                    {
                        <td>
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(prod.ProdutoId))">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => Excluir(prod.ProdutoId))">Excluir</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Produto>? produtos;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        produtos = await Http.GetFromJsonAsync<List<Produto>>("api/Produtos");
    }

    private void IrParaCriarProduto()
    {
        Navigation.NavigateTo("/produtos/novo");
    }

    private void Editar(int produtoId)
    {
        Navigation.NavigateTo($"/produtos/editar/{produtoId}");
    }

    private async Task Excluir(int produtoId)
    {
        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm", $"Tem certeza que deseja excluir o produto {produtoId}?");
        if (!confirmar) return;

        var response = await Http.DeleteAsync($"api/Produtos/{produtoId}");
        if (response.IsSuccessStatusCode)
        {
            await CarregarProdutos();
        }
        else
        {
            // Tratar erro conforme necessário
        }
    }
}
