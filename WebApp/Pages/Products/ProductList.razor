@page "/produtos"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Lista de Produtos</PageTitle>
<h3>Lista de Produtos</h3>

@if (produtos == null)
{
    <p>Carregando...</p>
}
else if (!produtos.Any())
{
    <p>Nenhum produto encontrado.</p>
}
else
{
    <div class="mb-3">
        @if (AuthService.IsAdmin || AuthService.IsManager)
        {
            <button class="btn btn-primary me-2" @onclick="IrParaCriarProduto">Criar Novo Produto</button>
            <a href="/prices/new" class="btn btn-primary">Registar Preço</a>
        }
    </div>
    
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Marca</th>
                <th>Categoria</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in produtos)
            {
                <tr>
                    <td>@prod.ProdutoId</td>
                    <td>@prod.Nome</td>
                    <td>@prod.Marca</td>
                    <td>@prod.Categoria?.Nome</td>
                    <td>
                        <a href="/productdetails/@prod.ProdutoId" class="btn btn-info btn-sm me-2">Ver Detalhes</a>
                        @if (AuthService.IsAdmin || AuthService.IsManager)
                        {
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(prod.ProdutoId))">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => ConfirmarExclusao(prod.ProdutoId, prod.Nome))">Excluir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Anterior</button>
        <span>Página @currentPage de @totalPages</span>
        <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoNext)">Próximo</button>
    </div>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

<!-- Popup de Confirmação para Exclusão -->
@if (showConfirmPopup)
{
    <div class="confirm-overlay">
        <div class="confirm-content">
            <h5 style="color: #d32f2f;">Confirmação</h5>
            <p style="color: #333;">Tem certeza que deseja excluir o produto "@produtoNomeToDelete"?</p>
            <div class="confirm-buttons">
                <button class="btn btn-danger" @onclick="Excluir">Sim</button>
                <button class="btn btn-secondary" @onclick="FecharConfirmPopup">Não</button>
            </div>
        </div>
    </div>
}

<style>
    .confirm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .confirm-content {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
        text-align: center;
    }

    .confirm-content h5 {
        margin: 0 0 10px 0;
        font-size: 18px;
    }

    .confirm-content p {
        margin: 0 0 20px 0;
        font-size: 16px;
    }

    .confirm-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .confirm-buttons .btn {
        padding: 8px 20px;
        font-size: 14px;
    }
</style>

@code {
    private List<Produto>? produtos;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool showConfirmPopup = false;
    private int? produtoIdToDelete = null;
    private string produtoNomeToDelete = "";

    protected override async Task OnInitializedAsync()
    {
        // Verificar se há uma mensagem de sucesso na URL
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var successMessage = query["successMessage"];
        if (!string.IsNullOrEmpty(successMessage))
        {
            ShowPopup(successMessage, MessagePopup.MessageType.Success);
        }

        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        try
        {
            var response = await Http.GetAsync($"api/Produtos?page={currentPage}&pageSize={pageSize}");
            if (response.IsSuccessStatusCode)
            {
                produtos = await response.Content.ReadFromJsonAsync<List<Produto>>();

                if (response.Headers.TryGetValues("X-Total-Count", out var values))
                {
                    if (int.TryParse(values.FirstOrDefault(), out int totalItems))
                    {
                        totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                    }
                }
                else
                {
                    totalPages = 1;
                }

                // LÓGICA DE FALLBACK
                if (currentPage > totalPages && totalPages > 0)
                {
                    currentPage = totalPages;
                    await CarregarProdutos();
                    return;
                }
            }
            else
            {
                produtos = new List<Produto>();
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar os produtos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar os produtos: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            produtos = new List<Produto>();
            ShowPopup($"Erro inesperado ao carregar os produtos: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await CarregarProdutos();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await CarregarProdutos();
        }
    }

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    private void IrParaCriarProduto() => Navigation.NavigateTo("/produtos/novo");
    private void Editar(int produtoId) => Navigation.NavigateTo($"/produtos/editar/{produtoId}");

    private void ConfirmarExclusao(int produtoId, string nome)
    {
        produtoIdToDelete = produtoId;
        produtoNomeToDelete = nome;
        showConfirmPopup = true;
    }

    private void FecharConfirmPopup()
    {
        showConfirmPopup = false;
        produtoIdToDelete = null;
        produtoNomeToDelete = "";
    }

    private async Task Excluir()
    {
        if (produtoIdToDelete == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Produtos/{produtoIdToDelete}");
            if (response.IsSuccessStatusCode)
            {
                ShowPopup($"Produto '{produtoNomeToDelete}' excluído com sucesso!", MessagePopup.MessageType.Success);
                await CarregarProdutos();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup($"Erro ao excluir o produto '{produtoNomeToDelete}'. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao excluir o produto: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao excluir o produto: {ex.Message}", MessagePopup.MessageType.Error);
        }

        FecharConfirmPopup();
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
