@page "/produtos/editar/{id:int}"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Editar Produto</PageTitle>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para editar produtos.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <h3>Editar Produto</h3>

    @if (produto == null)
    {
        <p>Carregando produto...</p>
    }
    else
    {
        <EditForm Model="produto" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Nome:</label>
                <InputText class="form-control" @bind-Value="produto.Nome" />
            </div>
            <div class="mb-3">
                <label>Marca:</label>
                <InputText class="form-control" @bind-Value="produto.Marca" />
            </div>
            <div class="mb-3">
                <label>Descrição:</label>
                <InputText class="form-control" @bind-Value="produto.Descricao" />
            </div>

            <div class="mb-3">
                <label>Categoria:</label>
                <select class="form-select" @bind="produto.CategoriaId">
                    @if (categorias != null)
                    {
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.CategoriaId">@cat.Nome</option>
                        }
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">Voltar</button>
        </EditForm>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter] public int id { get; set; }
    private Produto? produto;
    private List<Categoria>? categorias;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            try
            {
                // 1. Carrega a lista de categorias
                var catResponse = await Http.GetAsync("api/Categorias");
                if (catResponse.IsSuccessStatusCode)
                {
                    categorias = await catResponse.Content.ReadFromJsonAsync<List<Categoria>>();
                }
                else
                {
                    categorias = new List<Categoria>();
                    var errorContent = await catResponse.Content.ReadAsStringAsync();
                    try
                    {
                        var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                        if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                        {
                            ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                        }
                        else
                        {
                            ShowPopup("Erro ao carregar as categorias. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                        }
                    }
                    catch
                    {
                        ShowPopup($"Erro ao carregar as categorias: {errorContent}", MessagePopup.MessageType.Error);
                    }
                }

                // 2. Carrega o produto
                var prodResponse = await Http.GetAsync($"api/Produtos/{id}");
                if (prodResponse.IsSuccessStatusCode)
                {
                    produto = await prodResponse.Content.ReadFromJsonAsync<Produto>();
                    if (produto != null && produto.Categoria != null)
                    {
                        // Ajusta o CategoriaId e zera "Categoria" para não enviar no PUT
                        produto.CategoriaId = produto.Categoria.CategoriaId;
                        produto.Categoria = null;
                    }
                }
                else
                {
                    produto = null;
                    var errorContent = await prodResponse.Content.ReadAsStringAsync();
                    try
                    {
                        var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                        if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                        {
                            ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                        }
                        else
                        {
                            ShowPopup("Erro ao carregar o produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                        }
                    }
                    catch
                    {
                        ShowPopup($"Erro ao carregar o produto: {errorContent}", MessagePopup.MessageType.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                produto = null;
                categorias = new List<Categoria>();
                ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (produto == null) return;

        try
        {
            // Garante que não enviamos o objeto "Categoria"
            produto.Categoria = null;

            var response = await Http.PutAsJsonAsync($"api/Produtos/{id}", produto);
            if (response.IsSuccessStatusCode)
            {
                ShowPopup("Produto atualizado com sucesso!", MessagePopup.MessageType.Success);
                Navigation.NavigateTo("/produtos");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao atualizar o produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao atualizar o produto: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao atualizar o produto: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Voltar() => Navigation.NavigateTo("/produtos");

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
