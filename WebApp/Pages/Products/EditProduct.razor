@page "/produtos/editar/{id:int}"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Editar Produto</PageTitle>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para editar produtos.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else if (id <= 0)
{
    <p class="text-danger">ID do produto inválido.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else if (!isInitialized)
{
    <p>Carregando dados do produto...</p>
}
else if (produto == null)
{
    <p class="text-danger">Produto não encontrado ou erro ao carregar os dados.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <h3>Editar Produto</h3>

    <EditForm Model="produto" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nome:</label>
            <InputText class="form-control" @bind-Value="produto.Nome" />
        </div>
        <div class="mb-3">
            <label>Marca:</label>
            <InputText class="form-control" @bind-Value="produto.Marca" />
        </div>
        <div class="mb-3">
            <label>Descrição:</label>
            <InputText class="form-control" @bind-Value="produto.Descricao" />
        </div>

        <div class="mb-3">
            <label>Categoria:</label>
            @if (categorias == null || categorias.Count == 0)
            {
                <p class="text-danger">Nenhuma categoria disponível. Por favor, crie uma categoria primeiro.</p>
            }
            else
            {
                <select class="form-select" @bind="produto.CategoriaId">
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.CategoriaId">@cat.Nome</option>
                    }
                </select>
            }
        </div>

        <button type="submit" class="btn btn-primary" disabled="@(categorias == null || categorias.Count == 0)">Salvar Alterações</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">Voltar</button>
    </EditForm>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter] public int id { get; set; }
    private Produto? produto;
    private List<Categoria>? categorias;
    private bool isInitialized = false;
    private bool shouldRedirect = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (id <= 0)
        {
            ShowPopup("ID do produto inválido.", MessagePopup.MessageType.Error);
            isInitialized = true;
            return;
        }

        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            try
            {
                // Carrega a lista de categorias
                var catResponse = await Http.GetAsync("api/Categorias");
                if (catResponse.IsSuccessStatusCode)
                {
                    var apiResponse = await catResponse.Content.ReadFromJsonAsync<ApiResponse<List<Categoria>>>();
                    if (apiResponse?.Success == true)
                    {
                        categorias = apiResponse.Data ?? new List<Categoria>();
                    }
                    else
                    {
                        categorias = new List<Categoria>();
                        ShowPopup(apiResponse?.Message ?? "Erro ao carregar as categorias.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    categorias = new List<Categoria>();
                    ShowPopup("Erro ao carregar as categorias. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }

                // Carrega o produto
                var prodResponse = await Http.GetAsync($"api/Produtos/{id}");
                if (prodResponse.IsSuccessStatusCode)
                {
                    var apiResponse = await prodResponse.Content.ReadFromJsonAsync<ApiResponse<Produto>>();
                    if (apiResponse?.Success == true && apiResponse.Data != null)
                    {
                        produto = apiResponse.Data;
                        if (produto.Categoria != null)
                        {
                            produto.CategoriaId = produto.Categoria.CategoriaId;
                            produto.Categoria = null;
                        }
                    }
                    else
                    {
                        produto = null;
                        ShowPopup(apiResponse?.Message ?? "Erro ao carregar o produto.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    produto = null;
                    ShowPopup("Erro ao carregar o produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
            catch (Exception ex)
            {
                produto = null;
                categorias = new List<Categoria>();
                ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
            }
            finally
            {
                isInitialized = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (produto == null) return;

        if (string.IsNullOrWhiteSpace(produto.Nome))
        {
            ShowPopup("O nome do produto é obrigatório.", MessagePopup.MessageType.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(produto.Marca))
        {
            ShowPopup("A marca do produto é obrigatória.", MessagePopup.MessageType.Error);
            return;
        }

        if (categorias == null || categorias.Count == 0 || produto.CategoriaId <= 0)
        {
            ShowPopup("Selecione uma categoria válida.", MessagePopup.MessageType.Error);
            return;
        }

        try
        {
            produto.Categoria = null;

            Console.WriteLine($"[DEBUG] Atualizando produto: ID={produto.ProdutoId}, Nome={produto.Nome}, Marca={produto.Marca}, CategoriaId={produto.CategoriaId}");

            var response = await Http.PutAsJsonAsync($"api/Produtos/{id}", produto);
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (response.IsSuccessStatusCode && apiResponse?.Success == true)
            {
                shouldRedirect = true;
                ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
            }
            else
            {
                ShowPopup(apiResponse?.Message ?? "Erro ao atualizar o produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao atualizar o produto: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);

        if (shouldRedirect)
        {
            Navigation.NavigateTo($"/produtos?successMessage={Uri.EscapeDataString("Produto atualizado com sucesso!")}");
            shouldRedirect = false;
        }
    }

    private void Voltar() => Navigation.NavigateTo("/produtos");

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
