@page "/users"
@using WebApp.Models
@inject HttpClient Http
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h2>Gestão de Utilizadores</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para gerenciar utilizadores.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <p>Aqui você poderá ver a lista de utilizadores, alterar permissões e remover contas.</p>

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="CriarNovo">Criar Novo Utilizador</button>
    </div>

    @if (utilizadores == null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>TipoUtilizador</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in utilizadores)
                {
                    <tr>
                        <td>@u.UtilizadorId</td>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td>@u.TipoUtilizador?.Tipo</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(u.UtilizadorId))">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => RemoverConta(u.UtilizadorId))">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<Utilizador>? utilizadores;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            utilizadores = await Http.GetFromJsonAsync<List<Utilizador>>("api/Utilizadores");
        }
    }

    private void CriarNovo()
    {
        Navigation.NavigateTo("/users/new");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/users/edit/{id}");
    }

    private async Task RemoverConta(int id)
    {
        bool confirmar = await JSRuntime.InvokeAsync<bool>(
            "window.confirm",
            new object[] { $"Deseja remover a conta do user {id}?" }
        );
        if (!confirmar) return;

        var response = await Http.DeleteAsync($"api/Utilizadores/{id}");
        if (response.IsSuccessStatusCode)
        {
            utilizadores = await Http.GetFromJsonAsync<List<Utilizador>>("api/Utilizadores");
        }
        else
        {
            // Exibir mensagem de erro
        }
    }

    private void Voltar() => Navigation.NavigateTo("/homeadmin");
}
