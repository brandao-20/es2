@page "/relatorioproduto"
@using System.Net.Http.Json
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Relatório do Produto</PageTitle>
<h3>Relatório do Produto</h3>

@if (produtos == null)
{
    <p>Carregando produtos...</p>
}
else if (!produtos.Any())
{
    <p>Nenhum produto disponível.</p>
}
else
{
    <div class="mb-3">
        <label for="produtoSelect" class="form-label">Selecione um Produto:</label>
        <select id="produtoSelect" class="form-select" @bind="selectedProdutoId" @bind:after="LoadProdutoReport">
            <option value="0">Selecione um produto...</option>
            @foreach (var produto in produtos)
            {
                <option value="@produto.ProdutoId">@produto.Nome</option>
            }
        </select>
    </div>

    @if (produtoReport != null)
    {
        <div class="card mb-3">
            <div class="card-header">
                <strong>@produtoReport.Nome</strong> - Categoria: @produtoReport.Categoria
            </div>
            <div class="card-body">
                <p><strong>Lojas e Últimos Preços:</strong></p>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Loja</th>
                            <th>Último Preço</th>
                            <th>Data do Registo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loja in produtoReport.Lojas)
                        {
                            <tr>
                                <td>@loja.LojaNome</td>
                                <td>@loja.LatestPrice.ToString("C", new System.Globalization.CultureInfo("pt-PT"))</td>
                                <td>@loja.LatestDate.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (selectedProdutoId > 0)
    {
        <p>Carregando relatório...</p>
    }
}

<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private List<ProdutoDto>? produtos;
    private int selectedProdutoId;
    private ProdutoReportDto? produtoReport;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadProdutos();
    }

    private async Task LoadProdutos()
    {
        try
        {
            var response = await Http.GetAsync("api/Relatorios/produtos");
            if (response.IsSuccessStatusCode)
            {
                produtos = await response.Content.ReadFromJsonAsync<List<ProdutoDto>>();
                if (produtos == null || !produtos.Any())
                {
                    ShowPopup("Nenhum produto disponível.", MessagePopup.MessageType.Info);
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ShowPopup($"Erro ao carregar a lista de produtos: {errorContent}", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro ao carregar produtos: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task LoadProdutoReport()
    {
        if (selectedProdutoId == 0)
        {
            produtoReport = null;
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/Relatorios/produtos/{selectedProdutoId}");
            if (response.IsSuccessStatusCode)
            {
                produtoReport = await response.Content.ReadFromJsonAsync<ProdutoReportDto>();
                if (produtoReport == null || !produtoReport.Lojas.Any())
                {
                    ShowPopup("Nenhum dado disponível para este produto.", MessagePopup.MessageType.Info);
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ShowPopup($"Erro ao carregar o relatório do produto: {errorContent}", MessagePopup.MessageType.Error);
                produtoReport = null;
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro ao carregar o relatório: {ex.Message}", MessagePopup.MessageType.Error);
            produtoReport = null;
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    public class ProdutoDto
    {
        public int ProdutoId { get; set; }
        public string Nome { get; set; } = string.Empty;
    }

    public class ProdutoReportDto
    {
        public int ProdutoId { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string? Categoria { get; set; }
        public List<LojaPriceDto> Lojas { get; set; } = new();
    }

    public class LojaPriceDto
    {
        public int LojaId { get; set; }
        public string? LojaNome { get; set; }
        public decimal LatestPrice { get; set; }
        public DateTime LatestDate { get; set; }
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
