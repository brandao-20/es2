@page "/exportreports"
@using WebApp.Components
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Exportar Relatórios</PageTitle>

<h3>Exportar Relatórios</h3>

<div class="mb-3">
    <label for="reportSelect">Selecione o relatório:</label>
    <select id="reportSelect" class="form-select" @bind="selectedReportType">
        <option value="stores">Relatório Geral de Lojas</option>
        <option value="products">Relatório Geral de Produtos</option>
        <option value="specificProduct">Relatório de Produto Específico</option>
    </select>
</div>

@if (selectedReportType == "specificProduct")
{
    <div class="mb-3">
        <label for="productSelect">Selecione o Produto:</label>
        <select id="productSelect" class="form-select" @bind="selectedProductId">
            <option value="">Selecione um produto...</option>
            @if (produtos != null)
            {
                @foreach (var produto in produtos)
                {
                    <option value="@produto.ProdutoId">@produto.Nome</option>
                }
            }
        </select>
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="ExportPdf">Exportar PDF</button>
    <button class="btn btn-secondary" @onclick="ExportCsv">Exportar CSV</button>
</div>

<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private string selectedReportType = "stores";
    private int? selectedProductId;
    private List<ProdutoDto>? produtos; // Lista de produtos para o dropdown
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Buscar a lista de produtos do backend
        try
        {
            var response = await Http.GetAsync("api/Relatorios/produtos");
            if (response.IsSuccessStatusCode)
            {
                produtos = await response.Content.ReadFromJsonAsync<List<ProdutoDto>>();
                if (produtos == null || !produtos.Any())
                {
                    ShowPopup("Nenhum produto disponível.", MessagePopup.MessageType.Info);
                }
            }
            else
            {
                ShowPopup("Erro ao carregar a lista de produtos.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro ao carregar produtos: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task ExportPdf()
    {
        string endpoint;
        if (selectedReportType == "specificProduct" && selectedProductId.HasValue)
        {
            endpoint = $"api/Export/produtos/{selectedProductId.Value}/pdf";
        }
        else
        {
            endpoint = selectedReportType switch
            {
                "stores" => "api/Export/lojas/pdf",
                "products" => "api/Export/produtos/pdf",
                _ => "api/Export/lojas/pdf"
            };
        }
        try
        {
            var response = await Http.GetAsync(endpoint);
            if (response.IsSuccessStatusCode)
            {
                var pdfData = await response.Content.ReadAsByteArrayAsync();
                string fileName = selectedReportType == "specificProduct"
                    ? $"produto_{selectedProductId}_report.pdf"
                    : $"{selectedReportType}_report.pdf";
                await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/pdf", pdfData);
                ShowPopup("PDF exportado com sucesso!", MessagePopup.MessageType.Success);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    ShowPopup(errorObj?.Message ?? "Erro ao exportar o PDF.", MessagePopup.MessageType.Error);
                }
                catch
                {
                    ShowPopup($"Erro ao exportar o PDF: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao exportar o PDF: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task ExportCsv()
    {
        string endpoint;
        if (selectedReportType == "specificProduct" && selectedProductId.HasValue)
        {
            endpoint = $"api/Export/produtos/{selectedProductId.Value}/csv";
        }
        else
        {
            endpoint = selectedReportType switch
            {
                "stores" => "api/Export/lojas/csv",
                "products" => "api/Export/produtos/csv",
                _ => "api/Export/lojas/csv"
            };
        }
        try
        {
            var response = await Http.GetAsync(endpoint);
            if (response.IsSuccessStatusCode)
            {
                var csvData = await response.Content.ReadAsByteArrayAsync();
                string fileName = selectedReportType == "specificProduct"
                    ? $"produto_{selectedProductId}_report.csv"
                    : $"{selectedReportType}_report.csv";
                await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "text/csv", csvData);
                ShowPopup("CSV exportado com sucesso!", MessagePopup.MessageType.Success);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    ShowPopup(errorObj?.Message ?? "Erro ao exportar o CSV.", MessagePopup.MessageType.Error);
                }
                catch
                {
                    ShowPopup($"Erro ao exportar o CSV: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao exportar o CSV: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    // Classe DTO para os produtos
    public class ProdutoDto
    {
        public int ProdutoId { get; set; }
        public string Nome { get; set; } = string.Empty;
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
