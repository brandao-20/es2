@page "/exportreports"
@using WebApp.Components
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Exportar Relatórios</PageTitle>

<h3>Exportar Relatórios</h3>

<div class="mb-3">
    <label for="reportSelect">Selecione o relatório:</label>
    <select id="reportSelect" class="form-select" @bind="selectedReport">
        <option value="stores">Relatório Geral de Lojas</option>
        <option value="products">Relatório Geral de Produtos</option>
    </select>
</div>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="ExportPdf">Exportar PDF</button>
    <button class="btn btn-secondary" @onclick="ExportCsv">Exportar CSV</button>
</div>

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private string selectedReport = "stores";
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    private async Task ExportPdf()
    {
        string endpoint = selectedReport switch
        {
            "stores" => "api/Export/lojas/pdf",
            "products" => "api/Export/produtos/pdf",
            _ => "api/Export/lojas/pdf"
        };
        try
        {
            var response = await Http.GetAsync(endpoint);
            if (response.IsSuccessStatusCode)
            {
                var pdfData = await response.Content.ReadAsByteArrayAsync();
                await JS.InvokeVoidAsync("downloadFileFromBytes", $"{selectedReport}_report.pdf", "application/pdf", pdfData);
                ShowPopup("PDF exportado com sucesso!", MessagePopup.MessageType.Success);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao exportar o PDF. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao exportar o PDF: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao exportar o PDF: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task ExportCsv()
    {
        string endpoint = selectedReport switch
        {
            "stores" => "api/Export/lojas/csv",
            "products" => "api/Export/produtos/csv", // Corrigido de "products" para "produtos"
            _ => "api/Export/lojas/csv"
        };
        try
        {
            var response = await Http.GetAsync(endpoint);
            if (response.IsSuccessStatusCode)
            {
                var csvData = await response.Content.ReadAsByteArrayAsync();
                await JS.InvokeVoidAsync("downloadFileFromBytes", $"{selectedReport}_report.csv", "text/csv", csvData);
                ShowPopup("CSV exportado com sucesso!", MessagePopup.MessageType.Success);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao exportar o CSV. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao exportar o CSV: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao exportar o CSV: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
