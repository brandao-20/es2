@page "/relatorioprodutos"
@using System.Net.Http.Json
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Relatório de Produtos</PageTitle>
<h3>Relatório de Produtos</h3>

@if (produtosReport == null)
{
    <p>Carregando relatório...</p>
}
else if (!produtosReport.Any())
{
    <p>Nenhum produto disponível.</p>
}
else
{
    @foreach (var produto in produtosReport)
    {
        <div class="report-section mb-4">
            <h4>@produto.Nome</h4>
            <p><strong>Categoria:</strong> @produto.Categoria</p>
            <p><strong>Lojas e Últimos Preços:</strong></p>
            <ul>
                @foreach (var loja in produto.Lojas)
                {
                    <li>@loja.LojaNome - @loja.LatestPrice.ToString("C") (@loja.LatestDate.ToString("g"))</li>
                }
            </ul>
        </div>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private List<ProdutoReportDto>? produtosReport;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var response = await Http.GetAsync("api/Relatorios/produtos");
            if (response.IsSuccessStatusCode)
            {
                produtosReport = await response.Content.ReadFromJsonAsync<List<ProdutoReportDto>>();
                if (produtosReport == null || !produtosReport.Any())
                {
                    ShowPopup("Nenhum dado disponível para o relatório de produtos.", MessagePopup.MessageType.Info);
                }
            }
            else
            {
                produtosReport = new List<ProdutoReportDto>();
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar o relatório de produtos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar o relatório de produtos: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            produtosReport = new List<ProdutoReportDto>();
            ShowPopup($"Erro inesperado ao carregar o relatório de produtos: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    public class ProdutoReportDto
    {
        public int ProdutoId { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string? Categoria { get; set; }
        public List<LojaPriceDto> Lojas { get; set; } = new();
    }

    public class LojaPriceDto
    {
        public int LojaId { get; set; }
        public string? LojaNome { get; set; }
        public decimal LatestPrice { get; set; }
        public DateTime LatestDate { get; set; }
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
