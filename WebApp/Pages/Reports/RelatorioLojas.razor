@page "/relatoriolojas"
@using System.Net.Http.Json
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Relatório de Lojas</PageTitle>
<h3>Relatório de Lojas</h3>

@if (lojasReport == null)
{
    <p>Carregando relatório...</p>
}
else
{
    @foreach (var loja in lojasReport)
    {
        <div class="card mb-3">
            <div class="card-header">
                <strong>@loja.Nome</strong> - @loja.Endereco
            </div>
            <div class="card-body">
                <p><em>Localização:</em> @loja.Localizacao?.Cidade, @loja.Localizacao?.Pais</p>
                <p><strong>Produtos por Categoria:</strong></p>
                <ul>
                    @foreach (var cat in loja.CategoriaCounts)
                    {
                        <li>@cat.CategoriaNome: @cat.Count produtos</li>
                    }
                </ul>
                <p><strong>Produtos e Últimos Preços:</strong></p>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Último Preço</th>
                            <th>Data do Registro</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in loja.Produtos)
                        {
                            <tr>
                                <td>@prod.ProdutoNome</td>
                                <td>@prod.LatestPrice.ToString("C")</td>
                                <td>@prod.LatestDate.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private List<LojaReportDto>? lojasReport;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var response = await Http.GetAsync("api/Relatorios/lojas");
            if (response.IsSuccessStatusCode)
            {
                lojasReport = await response.Content.ReadFromJsonAsync<List<LojaReportDto>>();
                if (lojasReport == null || !lojasReport.Any())
                {
                    ShowPopup("Nenhum dado disponível para o relatório de lojas.", MessagePopup.MessageType.Info);
                }
            }
            else
            {
                lojasReport = new List<LojaReportDto>();
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar o relatório de lojas. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar o relatório de lojas: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            lojasReport = new List<LojaReportDto>();
            ShowPopup($"Erro inesperado ao carregar o relatório de lojas: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    public class LojaReportDto
    {
        public int LojaId { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string Endereco { get; set; } = string.Empty;
        public LocalizacaoDto? Localizacao { get; set; }
        public List<CategoriaCountDto> CategoriaCounts { get; set; } = new();
        public List<ProdutoPriceDto> Produtos { get; set; } = new();
    }

    public class LocalizacaoDto
    {
        public int LocalizacaoId { get; set; }
        public string? Cidade { get; set; }
        public string? Pais { get; set; }
    }

    public class CategoriaCountDto
    {
        public int CategoriaId { get; set; }
        public string? CategoriaNome { get; set; }
        public int Count { get; set; }
    }

    public class ProdutoPriceDto
    {
        public int ProdutoId { get; set; }
        public string? ProdutoNome { get; set; }
        public decimal LatestPrice { get; set; }
        public DateTime LatestDate { get; set; }
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
