@page "/register"
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Registar Conta</PageTitle>
<h3>Registar Nova Conta</h3>

<EditForm Model="newUser" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label>Username:</label>
        <InputText class="form-control" @bind-Value="newUser.Username" />
    </div>
    <div class="mb-3">
        <label>Email:</label>
        <InputText type="email" class="form-control" @bind-Value="newUser.Email" />
    </div>
    <div class="mb-3">
        <label>Password:</label>
        <InputText type="password" class="form-control" @bind-Value="newUser.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Registar</button>
</EditForm>

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private User newUser = new();
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool shouldRedirect = false;

    private async Task HandleRegister()
    {
        try
        {
            // Validações iniciais
            if (string.IsNullOrWhiteSpace(newUser.Username))
            {
                ShowPopup("O nome de utilizador é obrigatório.", MessagePopup.MessageType.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(newUser.Email) || !IsValidEmail(newUser.Email))
            {
                ShowPopup("Email inválido.", MessagePopup.MessageType.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(newUser.Password))
            {
                ShowPopup("A senha é obrigatória.", MessagePopup.MessageType.Error);
                return;
            }

            // Verificar se o username ou email já existe
            var checkResponse = await Http.GetAsync($"api/Utilizadores/check?username={Uri.EscapeDataString(newUser.Username)}&email={Uri.EscapeDataString(newUser.Email)}");
            if (checkResponse.IsSuccessStatusCode)
            {
                var checkResult = await checkResponse.Content.ReadFromJsonAsync<ApiResponse<CheckAvailabilityResponse>>();
                if (checkResult?.Success == true)
                {
                    if (checkResult.Data?.UsernameExists == true)
                    {
                        ShowPopup("O nome de utilizador já está em uso.", MessagePopup.MessageType.Error);
                        return;
                    }
                    if (checkResult.Data?.EmailExists == true)
                    {
                        ShowPopup("O email já está em uso.", MessagePopup.MessageType.Error);
                        return;
                    }
                }
                else
                {
                    ShowPopup(checkResult?.Message ?? "Erro ao verificar disponibilidade.", MessagePopup.MessageType.Error);
                    return;
                }
            }
            else
            {
                ShowPopup("Erro ao verificar disponibilidade de username/email.", MessagePopup.MessageType.Error);
                return;
            }

            // Enviar requisição de registro
            var response = await Http.PostAsJsonAsync("api/Utilizadores/register", newUser);
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<User>>();

            if (response.IsSuccessStatusCode && apiResponse?.Success == true)
            {
                // Exibir popup de sucesso e marcar para redirecionar após o fechamento
                shouldRedirect = true;
                ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
            }
            else
            {
                // Tratar erros específicos retornados pelo backend
                if (apiResponse?.ErrorCode == "DUPLICATE_USERNAME")
                {
                    ShowPopup("O nome de utilizador já está em uso.", MessagePopup.MessageType.Error);
                }
                else if (apiResponse?.ErrorCode == "DUPLICATE_EMAIL")
                {
                    ShowPopup("O email já está em uso.", MessagePopup.MessageType.Error);
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao registar a conta. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao registar a conta: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private bool IsValidEmail(string email)
    {
        var emailRegex = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        return Regex.IsMatch(email, emailRegex);
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);

        // Redirecionar após o popup de sucesso ser fechado
        if (shouldRedirect)
        {
            Navigation.NavigateTo("/login");
            shouldRedirect = false;
        }
    }

    public class User
    {
        public int UtilizadorId { get; set; }
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public int TipoUtilizadorId { get; set; }
        public DateTime DataCriacao { get; set; }
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }

    private class CheckAvailabilityResponse
    {
        public bool UsernameExists { get; set; }
        public bool EmailExists { get; set; }
    }
}
