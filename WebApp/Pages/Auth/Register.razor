@page "/register"
@using System.Net.Http.Json
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Registar Conta</PageTitle>
<h3>Registar Nova Conta</h3>

<EditForm Model="newUser" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label>Username:</label>
        <InputText class="form-control" @bind-Value="newUser.Username" />
    </div>
    <div class="mb-3">
        <label>Email:</label>
        <InputText type="email" class="form-control" @bind-Value="newUser.Email" />
    </div>
    <div class="mb-3">
        <label>Password:</label>
        <InputText type="password" class="form-control" @bind-Value="newUser.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Registar</button>
</EditForm>

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private User newUser = new();
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    private async Task HandleRegister()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Utilizadores/register", newUser);
            if (response.IsSuccessStatusCode)
            {
                ShowPopup("Conta criada com sucesso!", MessagePopup.MessageType.Success);
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao registar a conta. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao registar a conta: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao registar a conta: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    public class User
    {
        public int UtilizadorId { get; set; }
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
