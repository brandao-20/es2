@page "/login"
@using System.Net.Http.Json
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject WebApp.Services.AuthService AuthService

<PageTitle>Login</PageTitle>
<h3>Login</h3>

<EditForm Model="loginRequest" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label>Username:</label>
        <InputText class="form-control" @bind-Value="loginRequest.Username" />
    </div>
    <div class="mb-3">
        <label>Password:</label>
        <InputText type="password" class="form-control" @bind-Value="loginRequest.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Login</button>
</EditForm>

<hr />
<button class="btn btn-danger" @onclick="LoginWithGoogle">Login com Google</button>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

@code {
    private LoginRequest loginRequest = new();
    private string message = "";

    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync("api/Auth/login", loginRequest);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (result is not null)
            {
                // Armazena o token e role retornados
                AuthService.Token = result.Token;
                AuthService.Role = result.Role;

                // Salva o token no localStorage
                await LocalStorage.SetItemAsync("authToken", result.Token);

                // Decodifica o token JWT para extrair os claims
                var handler = new JwtSecurityTokenHandler();
                var jwt = handler.ReadJwtToken(result.Token);

                // Extrai o nome (claim de ClaimTypes.Name)
                var nameClaim = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value;
                if (!string.IsNullOrEmpty(nameClaim))
                {
                    AuthService.UserName = nameClaim;
                }
                else
                {
                    AuthService.UserName = loginRequest.Username;
                }

                // Extrai o "utilizadorId" para que o front-end saiba qual conta está logada
                var userIdClaim = jwt.Claims.FirstOrDefault(c => c.Type == "utilizadorId")?.Value;
                if (int.TryParse(userIdClaim, out int userId))
                {
                    AuthService.UserId = userId;
                }

                // Redireciona conforme o papel do usuário
                if (result.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                    Navigation.NavigateTo("/homeadmin");
                else if (result.Role.Equals("UserManager", StringComparison.OrdinalIgnoreCase))
                    Navigation.NavigateTo("/homeusermanager");
                else
                    Navigation.NavigateTo("/homeuser");
            }
        }
        else
        {
            message = "Credenciais inválidas.";
        }
    }

    private void LoginWithGoogle()
    {
        Navigation.NavigateTo("http://localhost:5000/api/ExternalLogin/Google", forceLoad: true);
    }

    public class LoginRequest
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
        public string Role { get; set; } = "";
    }
}
