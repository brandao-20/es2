@page "/users/edit/{id:int}"
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<h3>Editar Utilizador</h3>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para editar utilizadores.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    @if (usuario == null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <EditForm Model="usuario" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Username:</label>
                <InputText class="form-control" @bind-Value="usuario.Username" />
            </div>
            <div class="mb-3">
                <label>Email:</label>
                <InputText class="form-control" @bind-Value="usuario.Email" />
            </div>
            <!-- Se quiser permitir mudar a password, exibir um campo para nova password -->
            <div class="mb-3">
                <label>Nova Password (opcional):</label>
                <InputText type="password" class="form-control" @bind-Value="novaPassword" />
            </div>

            <div class="mb-3">
                <label>Cargo (TipoUtilizador):</label>
                <select class="form-select" @bind="usuario.Tipo">
                    <option value="Admin">Admin</option>
                    <option value="UserManager">UserManager</option>
                    <option value="User">User</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Salvar</button>
        </EditForm>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter] public int id { get; set; }
    private UserDto? usuario;
    private string? novaPassword;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            try
            {
                var response = await Http.GetAsync($"api/Utilizadores/adminget/{id}");
                if (response.IsSuccessStatusCode)
                {
                    usuario = await response.Content.ReadFromJsonAsync<UserDto>();
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    try
                    {
                        var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                        if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                        {
                            ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                        }
                        else
                        {
                            ShowPopup("Erro ao carregar o utilizador. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                        }
                    }
                    catch
                    {
                        ShowPopup($"Erro ao carregar o utilizador: {errorContent}", MessagePopup.MessageType.Error);
                    }
                    usuario = null;
                }
            }
            catch (Exception ex)
            {
                ShowPopup($"Erro inesperado ao carregar o utilizador: {ex.Message}", MessagePopup.MessageType.Error);
                usuario = null;
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (usuario == null) return;

        try
        {
            usuario.NewPassword = novaPassword; // se existir
            var response = await Http.PutAsJsonAsync($"api/Utilizadores/adminedit/{id}", usuario);
            if (response.IsSuccessStatusCode)
            {
                ShowPopup("Utilizador atualizado com sucesso!", MessagePopup.MessageType.Success);
                Navigation.NavigateTo("/users");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao atualizar o utilizador. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao atualizar o utilizador: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao atualizar o utilizador: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Voltar() => Navigation.NavigateTo("/users");

    public class UserDto
    {
        public int UtilizadorId { get; set; }
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Tipo { get; set; } = "User"; // Admin, UserManager, User
        public string? NewPassword { get; set; }
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
