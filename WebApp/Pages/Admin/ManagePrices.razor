@page "/prices"
@using WebApp.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<h2>Gerir Preços</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para gerir preços.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else
{
    <p>Aqui você pode listar e gerenciar os preços dos produtos.</p>

    @if (precos == null)
    {
        <p>Carregando...</p>
    }
    else if (!precos.Any())
    {
        <p>Nenhum preço registrado.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Produto</th>
                    <th>Loja</th>
                    <th>Preço</th>
                    <th>Data</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in precos)
                {
                    <tr>
                        <td>@p.RegistoId</td>
                        <td>@p.ProdutoNome</td>
                        <td>@p.LojaNome</td>
                        <td>@p.Preco</td>
                        <td>@p.DataRegisto.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => Excluir(p.RegistoId))">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (!string.IsNullOrEmpty(message))
{
    <p style="color: red;">@message</p>
}

@code {
    private List<RegistoPrecoModel>? precos;
    private string message = ""; // Inicializado e usado

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (!AuthService.IsAdmin && !AuthService.IsManager)
        {
            Navigation.NavigateTo("/homeadmin");
            return;
        }

        await CarregarPrecos();
    }

    private async Task CarregarPrecos()
    {
        precos = await Http.GetFromJsonAsync<List<RegistoPrecoModel>>("api/RegistosPreco");
    }

    private async Task Excluir(int registoId)
    {
        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm", $"Deseja remover o registro de preço {registoId}?");
        if (!confirmar) return;

        var response = await Http.DeleteAsync($"api/RegistosPreco/{registoId}");
        if (response.IsSuccessStatusCode)
        {
            message = "Registro de preço removido com sucesso!";
            await CarregarPrecos();
        }
        else
        {
            var debug = await response.Content.ReadAsStringAsync();
            message = $"Erro ao remover registro: {debug}";
        }
    }

    private void GoBack() => Navigation.NavigateTo("/homeadmin");

    public class RegistoPrecoModel
    {
        public int RegistoId { get; set; }
        public int ProdutoId { get; set; }
        public string ProdutoNome { get; set; } = "";
        public int LojaId { get; set; }
        public string LojaNome { get; set; } = "";
        public decimal Preco { get; set; }
        public DateTime DataRegisto { get; set; }
    }
}
