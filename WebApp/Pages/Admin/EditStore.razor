@page "/stores/edit/{id:int}"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<h2>Editar Loja</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para editar lojas.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else
{
    @if (loja == null)
    {
        <p>Carregando loja...</p>
    }
    else
    {
        <EditForm Model="loja" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Nome:</label>
                <InputText class="form-control" @bind-Value="loja.Nome" />
            </div>

            <div class="mb-3">
                <label>Localização no Mapa:</label>
                <GoogleMap
                    Latitude="@(loja.Localizacao?.Latitude ?? 38.7223m)"
                    Longitude="@(loja.Localizacao?.Longitude ?? -9.1393m)"
                    OnMapClick="HandleMapClick" />
            </div>

            <div class="alert alert-info">
                Clique no mapa para mover o marcador e atualizar a localização.
                <br />
                Endereço: @(loja.Endereco ?? "Não definido")
                <br />
                Latitude: @(loja.Localizacao?.Latitude?.ToString() ?? "Não definido")
                <br />
                Longitude: @(loja.Localizacao?.Longitude?.ToString() ?? "Não definido")
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Voltar</button>
        </EditForm>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter] public int id { get; set; }
    private Loja? loja;

    // Propriedades para controlar o popup
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (!AuthService.IsAdmin && !AuthService.IsManager)
        {
            Navigation.NavigateTo("/homeadmin");
            return;
        }

        loja = await Http.GetFromJsonAsync<Loja>($"api/Lojas/{id}");
        if (loja?.Localizacao == null)
        {
            loja.Localizacao = new Localizacao { Latitude = 38.7223m, Longitude = -9.1393m };
        }
    }

    private async Task HandleSubmit()
    {
        if (loja == null) return;

        var response = await Http.PutAsJsonAsync($"api/Lojas/{id}", loja);
        if (response.IsSuccessStatusCode)
        {
            // Redireciona para a página de listagem com a mensagem de sucesso na query string
            Navigation.NavigateTo("/stores?successMessage=Loja%20atualizada%20com%20sucesso!");
        }
        else
        {
            var debug = await response.Content.ReadAsStringAsync();
            ShowPopup($"Erro ao atualizar loja: {debug}", MessagePopup.MessageType.Error);
        }
    }

    private async Task HandleMapClick((decimal lat, decimal lng, string address) data)
    {
        if (loja != null)
        {
            if (loja.Localizacao == null)
            {
                loja.Localizacao = new Localizacao();
            }
            loja.Localizacao.Latitude = data.lat;
            loja.Localizacao.Longitude = data.lng;
            loja.Endereco = data.address;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/stores");

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }
}
