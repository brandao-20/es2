@page "/users"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Gestão de Utilizadores</PageTitle>
<h2>Gestão de Utilizadores</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para gerenciar utilizadores.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <p>Aqui você poderá ver a lista de utilizadores, alterar permissões e remover contas.</p>

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="CriarNovo">Criar Novo Utilizador</button>
    </div>

    @if (utilizadores == null)
    {
        <p>Carregando...</p>
    }
    else if (!utilizadores.Any())
    {
        <p>Nenhum utilizador encontrado.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>TipoUtilizador</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in utilizadores)
                {
                    <tr>
                        <td>@u.UtilizadorId</td>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td>@u.TipoUtilizador?.Tipo</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(u.UtilizadorId))">
                                Editar
                            </button>
                            @if (u.UtilizadorId != AuthService.UserId)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="@(() => ConfirmarExclusao(u.UtilizadorId, u.Username))">
                                    Remover
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Anterior</button>
            <span>Página @currentPage de @totalPages</span>
            <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoNext)">Próximo</button>
        </div>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

<!-- Popup de Confirmação para Exclusão -->
@if (showConfirmPopup)
{
    <div class="confirm-overlay">
        <div class="confirm-content">
            <h5 style="color: #d32f2f;">Confirmação</h5>
            <p style="color: #333;">Deseja remover o utilizador "@userNameToDelete"?</p>
            <div class="confirm-buttons">
                <button class="btn btn-danger" @onclick="RemoverConta">Sim</button>
                <button class="btn btn-secondary" @onclick="FecharConfirmPopup">Não</button>
            </div>
        </div>
    </div>
}

<style>
    .confirm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .confirm-content {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
        text-align: center;
    }

    .confirm-content h5 {
        margin: 0 0 10px 0;
        font-size: 18px;
    }

    .confirm-content p {
        margin: 0 0 20px 0;
        font-size: 16px;
    }

    .confirm-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .confirm-buttons .btn {
        padding: 8px 20px;
        font-size: 14px;
    }
</style>

@code {
    private List<Utilizador>? utilizadores;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool showConfirmPopup = false;
    private int? userIdToDelete = null;
    private string userNameToDelete = "";

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Verificar se há uma mensagem de sucesso na URL
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var successMessage = query["successMessage"];
        if (!string.IsNullOrEmpty(successMessage))
        {
            ShowPopup(successMessage, MessagePopup.MessageType.Success);
        }

        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            await CarregarUtilizadores();
        }
    }

    private async Task CarregarUtilizadores()
    {
        try
        {
            var response = await Http.GetAsync($"api/Utilizadores?page={currentPage}&pageSize={pageSize}");
            if (response.IsSuccessStatusCode)
            {
                utilizadores = await response.Content.ReadFromJsonAsync<List<Utilizador>>();

                if (response.Headers.TryGetValues("X-Total-Count", out var values))
                {
                    if (int.TryParse(values.FirstOrDefault(), out int totalItems))
                    {
                        totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                    }
                }
                else
                {
                    totalPages = 1;
                }

                // Fallback: se a página atual ficar maior que o total de páginas, ajusta e recarrega
                if (currentPage > totalPages && totalPages > 0)
                {
                    currentPage = totalPages;
                    await CarregarUtilizadores();
                    return;
                }
            }
            else
            {
                utilizadores = new List<Utilizador>();
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup("Erro ao carregar os utilizadores. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao carregar os utilizadores: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            utilizadores = new List<Utilizador>();
            ShowPopup($"Erro inesperado ao carregar os utilizadores: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await CarregarUtilizadores();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await CarregarUtilizadores();
        }
    }

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    private void CriarNovo() => Navigation.NavigateTo("/users/new");
    private void Editar(int id) => Navigation.NavigateTo($"/users/edit/{id}");
    private void Voltar() => Navigation.NavigateTo("/homeadmin");

    private void ConfirmarExclusao(int id, string username)
    {
        userIdToDelete = id;
        userNameToDelete = username;
        showConfirmPopup = true;
    }

    private void FecharConfirmPopup()
    {
        showConfirmPopup = false;
        userIdToDelete = null;
        userNameToDelete = "";
    }

    private async Task RemoverConta()
    {
        if (userIdToDelete == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Utilizadores/{userIdToDelete}");
            if (response.IsSuccessStatusCode)
            {
                ShowPopup($"Utilizador '{userNameToDelete}' removido com sucesso!", MessagePopup.MessageType.Success);
                await CarregarUtilizadores();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    if (errorObj != null && !string.IsNullOrEmpty(errorObj.Message))
                    {
                        ShowPopup(errorObj.Message, MessagePopup.MessageType.Error);
                    }
                    else
                    {
                        ShowPopup($"Erro ao remover o utilizador '{userNameToDelete}'. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    }
                }
                catch
                {
                    ShowPopup($"Erro ao remover o utilizador: {errorContent}", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao remover o utilizador: {ex.Message}", MessagePopup.MessageType.Error);
        }

        FecharConfirmPopup();
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private class ErrorResponse
    {
        public int StatusCode { get; set; }
        public string Message { get; set; } = "";
        public string Detail { get; set; } = "";
    }
}
