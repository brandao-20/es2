@page "/users"
@using WebApp.Models
@inject HttpClient Http
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Gestão de Utilizadores</PageTitle>
<h2>Gestão de Utilizadores</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para gerenciar utilizadores.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <p>Aqui você poderá ver a lista de utilizadores, alterar permissões e remover contas.</p>

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="CriarNovo">Criar Novo Utilizador</button>
    </div>

    @if (utilizadores == null)
    {
        <p>Carregando...</p>
    }
    else if (!utilizadores.Any())
    {
        <p>Nenhum utilizador encontrado.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>TipoUtilizador</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in utilizadores)
                {
                    <tr>
                        <td>@u.UtilizadorId</td>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td>@u.TipoUtilizador?.Tipo</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(u.UtilizadorId))">
                                Editar
                            </button>
                            @if (u.UtilizadorId != AuthService.UserId)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="@(() => RemoverConta(u.UtilizadorId))">
                                    Remover
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Anterior</button>
            <span>Página @currentPage de @totalPages</span>
            <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoNext)">Próximo</button>
        </div>
    }
}

@code {
    private List<Utilizador>? utilizadores;

    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            await CarregarUtilizadores();
        }
    }

    private async Task CarregarUtilizadores()
    {
        var response = await Http.GetAsync($"api/Utilizadores?page={currentPage}&pageSize={pageSize}");
        if (response.IsSuccessStatusCode)
        {
            utilizadores = await response.Content.ReadFromJsonAsync<List<Utilizador>>();

            if (response.Headers.TryGetValues("X-Total-Count", out var values))
            {
                if (int.TryParse(values.FirstOrDefault(), out int totalItems))
                {
                    totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                }
            }
            else
            {
                totalPages = 1;
            }

            // Fallback: se a página atual ficar maior que o total de páginas, ajusta e recarrega
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
                await CarregarUtilizadores();
                return;
            }
        }
        else
        {
            utilizadores = new List<Utilizador>();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await CarregarUtilizadores();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await CarregarUtilizadores();
        }
    }

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    private void CriarNovo() => Navigation.NavigateTo("/users/new");
    private void Editar(int id) => Navigation.NavigateTo($"/users/edit/{id}");

    private async Task RemoverConta(int id)
    {
        bool confirmar = await JSRuntime.InvokeAsync<bool>("window.confirm", $"Deseja remover a conta do user {id}?");
        if (!confirmar) return;

        var response = await Http.DeleteAsync($"api/Utilizadores/{id}");
        if (response.IsSuccessStatusCode)
        {
            await CarregarUtilizadores();
        }
    }
    
    private void Voltar() => Navigation.NavigateTo("/homeadmin");
}
