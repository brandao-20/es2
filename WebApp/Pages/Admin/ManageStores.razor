@page "/stores"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Gerir Lojas</PageTitle>
<h2>Gerir Lojas</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para gerir lojas.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else
{
    <p>Aqui você poderá listar, editar e remover lojas.</p>
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="NovaLoja">Adicionar Nova Loja</button>
    </div>

    @if (lojas == null)
    {
        <p>Carregando...</p>
    }
    else if (!lojas.Any())
    {
        <p>Nenhuma loja cadastrada.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Logotipo</th> <!-- Nova coluna para o logotipo -->
                    <th>Nome</th>
                    <th>Endereço</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in lojas)
                {
                    <tr>
                        <td>
                            @{
                                var logoPath = GetLogoPath(l.Nome);
                                if (!string.IsNullOrEmpty(logoPath))
                                {
                                    <img src="@logoPath" alt="Logotipo de @l.Nome" class="logo-img" />
                                }
                                else
                                {
                                    <span>Sem logotipo</span>
                                }
                            }
                        </td>
                        <td>@l.Nome</td>
                        <td class="truncate-address">@l.Endereco</td>
                        <td>@l.Localizacao?.Latitude</td>
                        <td>@l.Localizacao?.Longitude</td>
                        <td>
                            <button class="btn btn-sm btn-info me-2" @onclick="@(() => VerDetalhes(l))">Ver Detalhes</button>
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(l.LojaId))">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => ConfirmarExclusao(l.LojaId, l.Nome))">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Anterior</button>
            <span>Página @currentPage de @totalPages</span>
            <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoNext)">Próximo</button>
        </div>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

<!-- Popup de Confirmação para Exclusão -->
@if (showConfirmPopup)
{
    <div class="confirm-overlay">
        <div class="confirm-content">
            <h5 style="color: #d32f2f;">Confirmação</h5>
            <p style="color: #333;">Deseja remover a loja "@lojaNomeToDelete"?</p>
            <div class="confirm-buttons">
                <button class="btn btn-danger" @onclick="Excluir">Sim</button>
                <button class="btn btn-secondary" @onclick="FecharConfirmPopup">Não</button>
            </div>
        </div>
    </div>
}

<!-- Modal para Detalhes -->
@if (lojaSelecionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalhes da Loja: @lojaSelecionada.Nome</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Nome:</strong> @lojaSelecionada.Nome</p>
                    <p><strong>Endereço:</strong> @lojaSelecionada.Endereco</p>
                    <p><strong>Latitude:</strong> @lojaSelecionada.Localizacao?.Latitude</p>
                    <p><strong>Longitude:</strong> @lojaSelecionada.Localizacao?.Longitude</p>
                    @if (lojaSelecionada.Localizacao != null)
                    {
                        <h6 class="mt-3">Street View:</h6>
                        <GoogleStreetView
                            Latitude="@(lojaSelecionada.Localizacao.Latitude ?? 38.7223m)"
                            Longitude="@(lojaSelecionada.Localizacao.Longitude ?? -9.1393m)" />
                    }
                    else
                    {
                        <p class="text-warning">Localização não disponível.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .confirm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .confirm-content {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
        text-align: center;
    }

    .confirm-content h5 {
        margin: 0 0 10px 0;
        font-size: 18px;
    }

    .confirm-content p {
        margin: 0 0 20px 0;
        font-size: 16px;
    }

    .confirm-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .confirm-buttons .btn {
        padding: 8px 20px;
        font-size: 14px;
    }

    /* Estilo para truncar o endereço */
    .truncate-address {
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Estilo para os logotipos */
    .logo-img {
        max-height: 40px; /* Ajusta a altura máxima do logotipo */
        max-width: 100px; /* Ajusta a largura máxima do logotipo */
        object-fit: contain; /* Mantém a proporção do logotipo */
    }
</style>

@code {
    private List<LojaModel>? lojas;
    private LojaModel? lojaSelecionada;

    // Paginação
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;

    // Propriedades para controlar o popup de mensagem
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    // Propriedades para controlar o popup de confirmação
    private bool showConfirmPopup = false;
    private int? lojaIdToDelete = null;
    private string lojaNomeToDelete = "";

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            await CarregarLojas();

            // Verifica se há uma mensagem de sucesso na query string
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var successMessage = query["successMessage"];
            if (!string.IsNullOrEmpty(successMessage))
            {
                ShowPopup(successMessage, MessagePopup.MessageType.Success);
            }
        }
    }

    private async Task CarregarLojas()
    {
        var response = await Http.GetAsync($"api/Lojas?page={currentPage}&pageSize={pageSize}");
        if (response.IsSuccessStatusCode)
        {
            lojas = await response.Content.ReadFromJsonAsync<List<LojaModel>>();

            if (response.Headers.TryGetValues("X-Total-Count", out var values))
            {
                if (int.TryParse(values.FirstOrDefault(), out int totalItems))
                {
                    totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                }
            }
            else
            {
                totalPages = 1;
            }

            // Fallback: se a página atual for maior que o total de páginas, voltar para a última página e recarregar
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
                await CarregarLojas();
                return;
            }
        }
        else
        {
            lojas = new List<LojaModel>();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await CarregarLojas();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await CarregarLojas();
        }
    }

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    private void GoBack() => Navigation.NavigateTo("/homeadmin");
    private void NovaLoja() => Navigation.NavigateTo("/stores/new");
    private void Editar(int lojaId) => Navigation.NavigateTo($"/stores/edit/{lojaId}");

    private void VerDetalhes(LojaModel loja)
    {
        lojaSelecionada = loja;
        StateHasChanged();
    }

    private void FecharModal()
    {
        lojaSelecionada = null;
        StateHasChanged();
    }

    private void ConfirmarExclusao(int lojaId, string nomeLoja)
    {
        lojaIdToDelete = lojaId;
        lojaNomeToDelete = nomeLoja;
        showConfirmPopup = true;
    }

    private void FecharConfirmPopup()
    {
        showConfirmPopup = false;
        lojaIdToDelete = null;
        lojaNomeToDelete = "";
    }

    private async Task Excluir()
    {
        if (lojaIdToDelete == null) return;

        var response = await Http.DeleteAsync($"api/Lojas/{lojaIdToDelete}");
        if (response.IsSuccessStatusCode)
        {
            ShowPopup("Loja removida com sucesso!", MessagePopup.MessageType.Success);
            await CarregarLojas();
        }
        else
        {
            var debug = await response.Content.ReadAsStringAsync();
            ShowPopup($"Erro ao remover loja: {debug}", MessagePopup.MessageType.Error);
        }

        FecharConfirmPopup();
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    // Função para mapear o nome da loja ao caminho do logotipo
    private string GetLogoPath(string nomeLoja)
    {
        if (string.IsNullOrEmpty(nomeLoja))
            return "";

        nomeLoja = nomeLoja.ToLower();

        if (nomeLoja.Contains("lidl"))
            return "/images/logos/lidl.png";
        if (nomeLoja.Contains("pingo doce"))
            return "/images/logos/pingo_doce.png";
        if (nomeLoja.Contains("continente"))
            return "/images/logos/continente.png";
        if (nomeLoja.Contains("intermarché") || nomeLoja.Contains("intermarche"))
            return "/images/logos/intermarche.png";
        if (nomeLoja.Contains("auchan"))
            return "/images/logos/auchan.png";
        if (nomeLoja.Contains("aldi"))
            return "/images/logos/aldi.png";
        if (nomeLoja.Contains("mercadona"))
            return "/images/logos/mercadona.png";
        if (nomeLoja.Contains("minipreço") || nomeLoja.Contains("mini preço"))
            return "/images/logos/minipreco.png";
        if (nomeLoja.Contains("apolonia"))
            return "/images/logos/apolonia.png";
        if (nomeLoja.Contains("e.leclerc"))
            return "/images/logos/eleclerc.png";
        if (nomeLoja.Contains("recheio"))
            return "/images/logos/recheio.png";
        if (nomeLoja.Contains("froiz"))
            return "/images/logos/froiz.png";
        if (nomeLoja.Contains("galego")) // Adicionado para reconhecer "Supermercados Galego"
            return "/images/logos/galego.png";

        return ""; // Retorna vazio se não encontrar um logotipo correspondente
    }

    public class LojaModel
    {
        public int LojaId { get; set; }
        public string Nome { get; set; } = "";
        public string Endereco { get; set; } = "";
        public int? LocalizacaoId { get; set; }
        public LocalizacaoModel? Localizacao { get; set; }
    }

    public class LocalizacaoModel
    {
        public int LocalizacaoId { get; set; }
        public decimal? Latitude { get; set; }
        public decimal? Longitude { get; set; }
        public string? GoogleMapsUrl { get; set; }
    }
}
