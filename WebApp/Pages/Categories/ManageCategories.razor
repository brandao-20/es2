@page "/admin/categories"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Gerir Categorias</PageTitle>
<h2>Gerir Categorias</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para gerir categorias.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else
{
    <p>Aqui você pode listar, adicionar, editar e remover categorias.</p>
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="NovaCategoria">Adicionar Nova Categoria</button>
    </div>

    @if (categorias == null)
    {
        <p>Carregando...</p>
    }
    else if (!categorias.Any())
    {
        <p>Nenhuma categoria cadastrada.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Categoria Pai</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in categorias)
                {
                    <tr>
                        <td>@cat.CategoriaId</td>
                        <td>@cat.Nome</td>
                        <td>@(cat.ParentId.HasValue ? categorias.FirstOrDefault(c => c.CategoriaId == cat.ParentId)?.Nome ?? "N/A" : "Nenhuma")</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(cat.CategoriaId))">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => ConfirmarExclusao(cat.CategoriaId, cat.Nome))">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Anterior</button>
            <span>Página @currentPage de @totalPages</span>
            <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoNext)">Próximo</button>
        </div>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

<!-- Popup de Confirmação para Exclusão -->
@if (showConfirmPopup)
{
    <div class="confirm-overlay">
        <div class="confirm-content">
            <h5 style="color: #d32f2f;">Confirmação</h5>
            <p style="color: #333;">Deseja remover a categoria "@categoriaNomeToDelete"?</p>
            <div class="confirm-buttons">
                <button class="btn btn-danger" @onclick="Excluir">Sim</button>
                <button class="btn btn-secondary" @onclick="FecharConfirmPopup">Não</button>
            </div>
        </div>
    </div>
}

<style>
    .confirm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .confirm-content {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
        text-align: center;
    }

    .confirm-content h5 {
        margin: 0 0 10px 0;
        font-size: 18px;
    }

    .confirm-content p {
        margin: 0 0 20px 0;
        font-size: 16px;
    }

    .confirm-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .confirm-buttons .btn {
        padding: 8px 20px;
        font-size: 14px;
    }
</style>

@code {
    private List<Categoria>? categorias;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool showConfirmPopup = false;
    private int? categoriaIdToDelete = null;
    private string categoriaNomeToDelete = "";

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!AuthService.IsAdmin && !AuthService.IsManager)
        {
            Navigation.NavigateTo("/homeadmin");
            return;
        }

        await CarregarCategorias();

        // Verifica se há uma mensagem de sucesso na query string
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var successMessage = query["successMessage"];
        if (!string.IsNullOrEmpty(successMessage))
        {
            ShowPopup(successMessage, MessagePopup.MessageType.Success);
        }
    }

    private async Task CarregarCategorias()
    {
        try
        {
            var response = await Http.GetAsync($"api/Categorias?page={currentPage}&pageSize={pageSize}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<Categoria>>>();
                if (apiResponse?.Success == true)
                {
                    categorias = apiResponse.Data ?? new List<Categoria>();
                    if (response.Headers.TryGetValues("X-Total-Count", out var values))
                    {
                        if (int.TryParse(values.FirstOrDefault(), out int totalItems))
                        {
                            totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                        }
                    }
                    else
                    {
                        totalPages = 1;
                    }

                    // Fallback: se a página atual for maior que o total de páginas, voltar para a última página e recarregar
                    if (currentPage > totalPages && totalPages > 0)
                    {
                        currentPage = totalPages;
                        await CarregarCategorias();
                        return;
                    }
                }
                else
                {
                    categorias = new List<Categoria>();
                    totalPages = 1;
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar as categorias.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                categorias = new List<Categoria>();
                totalPages = 1;
                ShowPopup("Erro ao carregar as categorias. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            categorias = new List<Categoria>();
            totalPages = 1;
            ShowPopup($"Erro inesperado ao carregar as categorias: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await CarregarCategorias();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await CarregarCategorias();
        }
    }

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    private void GoBack() => Navigation.NavigateTo("/homeadmin");

    private void NovaCategoria() => Navigation.NavigateTo("/categories/new");

    private void Editar(int categoriaId) => Navigation.NavigateTo($"/categories/edit/{categoriaId}");

    private void ConfirmarExclusao(int categoriaId, string nomeCategoria)
    {
        categoriaIdToDelete = categoriaId;
        categoriaNomeToDelete = nomeCategoria;
        showConfirmPopup = true;
    }

    private void FecharConfirmPopup()
    {
        showConfirmPopup = false;
        categoriaIdToDelete = null;
        categoriaNomeToDelete = "";
    }

    private async Task Excluir()
    {
        if (categoriaIdToDelete == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Categorias/{categoriaIdToDelete}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
                if (apiResponse?.Success == true)
                {
                    ShowPopup("Categoria removida com sucesso!", MessagePopup.MessageType.Success);
                    await CarregarCategorias();
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao remover a categoria.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ShowPopup($"Erro ao remover a categoria: {errorContent}", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao remover a categoria: {ex.Message}", MessagePopup.MessageType.Error);
        }

        FecharConfirmPopup();
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
