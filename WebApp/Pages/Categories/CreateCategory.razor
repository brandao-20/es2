@page "/categories/new"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Nova Categoria</PageTitle>
<h3>Nova Categoria</h3>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para criar categorias.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else if (!isInitialized)
{
    <p>Carregando...</p>
}
else
{
    <div class="card p-4">
        <EditForm Model="@novaCategoria" OnValidSubmit="HandleCreate">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label class="form-label">Nome:</label>
                <InputText class="form-control" @bind-Value="novaCategoria.Nome" />
                <ValidationMessage For="@(() => novaCategoria.Nome)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Categoria Pai:</label>
                <select class="form-select" @bind="novaCategoria.ParentId">
                    <option value="">Nenhuma</option>
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.CategoriaId">@cat.Nome</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Criar</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Cancelar</button>
        </EditForm>
    </div>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private Categoria novaCategoria = new Categoria();
    private List<Categoria>? categorias;
    private bool isInitialized = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!AuthService.IsAdmin && !AuthService.IsManager)
        {
            Navigation.NavigateTo("/homeadmin");
            return;
        }

        try
        {
            // Carregar categorias existentes para o dropdown
            var response = await Http.GetAsync("api/Categorias");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<Categoria>>>();
                if (apiResponse?.Success == true)
                {
                    categorias = apiResponse.Data ?? new List<Categoria>();
                }
                else
                {
                    categorias = new List<Categoria>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar as categorias.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                categorias = new List<Categoria>();
                ShowPopup("Erro ao carregar as categorias. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            categorias = new List<Categoria>();
            ShowPopup($"Erro inesperado ao carregar as categorias: {ex.Message}", MessagePopup.MessageType.Error);
        }
        finally
        {
            isInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleCreate()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Categorias", novaCategoria);
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
                if (apiResponse?.Success == true)
                {
                    Navigation.NavigateTo($"/admin/categories?successMessage={Uri.EscapeDataString("Categoria criada com sucesso!")}");
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao criar a categoria.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ShowPopup($"Erro ao criar a categoria: {errorContent}", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao criar a categoria: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/admin/categories");

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
