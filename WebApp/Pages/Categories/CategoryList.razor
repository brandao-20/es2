@page "/categories"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Lista de Categorias</PageTitle>
<h3>Lista de Categorias</h3>

@if (categorias == null)
{
    <p>Carregando...</p>
}
else if (!categorias.Any())
{
    <p>Nenhuma categoria cadastrada.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Categoria Pai</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in categorias.OrderBy(c => c.Nome))
            {
                <tr>
                    <td>@cat.Nome</td>
                    <td>@(cat.ParentId.HasValue ? GetCategoriaPaiNome(cat.ParentId.Value) : "Nenhuma")</td>
                </tr>
                @if (cat.SubCategorias != null && cat.SubCategorias.Any())
                {
                    @RenderSubCategories(cat.SubCategorias, 1)
                }
            }
        </tbody>
    </table>
}

@code {
    private List<Categoria>? categorias;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCategorias();
    }

    private async Task CarregarCategorias()
    {
        try
        {
            var response = await Http.GetAsync("api/Categorias");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<Categoria>>>();
                if (apiResponse?.Success == true)
                {
                    categorias = apiResponse.Data ?? new List<Categoria>();
                }
                else
                {
                    categorias = new List<Categoria>();
                }
            }
            else
            {
                categorias = new List<Categoria>();
            }
        }
        catch (Exception)
        {
            categorias = new List<Categoria>();
        }
    }

    private string GetCategoriaPaiNome(int parentId)
    {
        var pai = categorias?.SelectMany(c => new[] { c }.Concat(c.SubCategorias ?? new List<Categoria>()))
                            .FirstOrDefault(c => c.CategoriaId == parentId);
        return pai?.Nome ?? "N/A";
    }

    private RenderFragment RenderSubCategories(List<Categoria> subCategorias, int nivel) => __builder =>
    {
        foreach (var subCat in subCategorias.OrderBy(c => c.Nome))
        {
            <tr>
                <td style="padding-left: @(nivel * 20)px;">└ @subCat.Nome</td>
                <td>@(subCat.ParentId.HasValue ? GetCategoriaPaiNome(subCat.ParentId.Value) : "Nenhuma")</td>
            </tr>
            if (subCat.SubCategorias != null && subCat.SubCategorias.Any())
            {
                @RenderSubCategories(subCat.SubCategorias, nivel + 1)
            }
        }
    };

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
