<div id="@MapId" style="height: 300px; width: 100%;"></div>

@code {
    [Parameter] public decimal Latitude { get; set; }
    [Parameter] public decimal Longitude { get; set; }
    [Inject] IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] IConfiguration Configuration { get; set; } = default!;

    private string MapId { get; set; } = $"streetview_{Guid.NewGuid().ToString().Replace("-", "")}";
    private bool googleMapsLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadGoogleMaps();
            await InitializeStreetView();
        }
    }

    private async Task LoadGoogleMaps()
    {
        try
        {
            var apiKey = Configuration["GoogleMapsApiKey"] ?? "SUA_CHAVE_AQUI";
            if (!googleMapsLoaded)
            {
                await JSRuntime.InvokeVoidAsync("mapsInterop.loadGoogleMaps", apiKey);
                googleMapsLoaded = true;
            }
            await WaitForGoogleMaps();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Erro ao carregar Google Maps API: {ex.Message}");
        }
    }

    private async Task WaitForGoogleMaps()
    {
        int attempts = 0;
        const int maxAttempts = 200;
        while (attempts < maxAttempts)
        {
            try
            {
                var loaded = await JSRuntime.InvokeAsync<bool>("eval", "typeof google !== 'undefined' && typeof google.maps !== 'undefined' && window.googleMapsLoaded === true");
                if (loaded)
                {
                    Console.WriteLine("[DEBUG] Google Maps API carregada com sucesso para Street View.");
                    return;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DEBUG] Erro ao verificar Google Maps API: {ex.Message}");
            }
            Console.WriteLine($"[DEBUG] Aguardando Google Maps API para Street View... Tentativa {attempts + 1}/{maxAttempts}");
            await Task.Delay(100);
            attempts++;
        }
        throw new Exception("Timeout: Google Maps API não carregou após 20 segundos.");
    }

    private async Task InitializeStreetView()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("mapsInterop.initStreetView", MapId, (double)Latitude, (double)Longitude);
            Console.WriteLine($"[DEBUG] Street View inicializado para Lat: {Latitude}, Lng: {Longitude}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Erro ao inicializar Street View: {ex.Message}");
        }
    }
}
